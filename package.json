{
  "name": "manaus-live-transit",
  "version": "1.0.0",
  "description": "Manaus Live Transit — Web-Native Ultra PWA for Real-Time Public Transit",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "./server/node_modules/.bin/tsx --test tests/routing.test.ts tests/web-regressions.test.ts tests/theme-alerts.test.ts",
    "sim": "python3 scripts/sim.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "puppeteer-core": "^25.10.0"
  }
}
