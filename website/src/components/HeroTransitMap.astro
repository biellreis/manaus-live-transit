---
---
<div class="hero-transit-stage" aria-hidden="true">
  <svg class="transit-svg-canvas" viewBox="0 0 1000 700" fill="none" preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Base Gradients -->
      <linearGradient id="routeGrad640" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.4"/>
        <stop offset="50%" stop-color="#2563eb" stop-opacity="1"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.8"/>
      </linearGradient>

      <linearGradient id="routeGrad300" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.6"/>
      </linearGradient>

      <!-- Soft Contact Glow (Zero Neon) -->
      <filter id="subtleShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.6"/>
      </filter>
    </defs>

    <!-- Geographic Base Grid of Centro de Manaus -->
    <g class="manaus-streets" stroke="#ffffff" stroke-opacity="0.04" stroke-width="1.5">
      <!-- Av. Constantino Nery Axis -->
      <path d="M 80 -20 L 220 180 L 340 320 L 460 440 L 590 530 L 720 590 L 890 640" stroke-width="2.5" stroke-opacity="0.07"/>
      <!-- Av. Djalma Batista -->
      <path d="M 280 -20 L 380 150 L 490 300 L 610 430 L 750 540 L 920 620"/>
      <!-- Rua Leonardo Malcher & Crossings -->
      <path d="M 200 480 L 780 340"/>
      <path d="M 320 590 L 880 430"/>
      <!-- Praça da Saudade & Centro Grid -->
      <circle cx="590" cy="530" r="45" stroke-opacity="0.05" fill="none"/>
      <path d="M 520 530 L 660 530"/>
      <path d="M 590 470 L 590 600"/>
      <!-- Praça da Matriz / Porto de Manaus -->
      <path d="M 700 580 C 760 620, 840 640, 920 640 C 970 640, 1020 620, 1060 580" stroke-width="3" stroke-opacity="0.06"/>
    </g>

    <!-- Official Secondary Line: Linha 300 (Expresso Norte) -->
    <path
      id="route-300"
      d="M 120 20 Q 260 210 390 340 T 630 500 T 840 610"
      stroke="url(#routeGrad300)"
      stroke-width="2"
      stroke-dasharray="6 6"
      stroke-linecap="round"
      fill="none"
    />

    <!-- Primary Official Trunk: Linha 640 (T4 / T3 / E1 / T1 / Centro) -->
    <path
      id="route-640"
      d="M 60 40 C 180 160, 260 260, 330 330 C 420 420, 480 470, 560 520 C 640 570, 710 590, 820 620 C 890 640, 950 635, 1010 650"
      stroke="url(#routeGrad640)"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- Real Transit Hubs Along Corridor -->
    <!-- Estação E1 São Jorge -->
    <g class="stop-hub" transform="translate(330, 330)">
      <circle r="4" fill="#ffffff" stroke="#2563eb" stroke-width="2.5"/>
      <text x="12" y="4" fill="#9ca3af" font-size="11" font-weight="600" letter-spacing="0.5">E1 São Jorge</text>
    </g>

    <!-- Terminal 1 (T1) - Constantino Nery -->
    <g class="stop-hub major-hub" transform="translate(560, 520)">
      <circle r="12" fill="#2563eb" fill-opacity="0.12"/>
      <circle r="6" fill="#ffffff" stroke="#2563eb" stroke-width="3"/>
      <text x="16" y="5" fill="#e5e7eb" font-size="12" font-weight="700" letter-spacing="0.4">Terminal 1 (T1)</text>
      <text x="16" y="19" fill="#9ca3af" font-size="10">Av. Constantino Nery</text>
    </g>

    <!-- Praça da Saudade / Centro -->
    <g class="stop-hub" transform="translate(820, 620)">
      <circle r="5" fill="#ffffff" stroke="#2563eb" stroke-width="2.5"/>
      <text x="-12" y="-12" fill="#9ca3af" font-size="11" font-weight="600" text-anchor="end">Praça da Saudade</text>
    </g>

    <!-- Moving Bus 640 Along Real Transit Path -->
    <g class="transit-vehicle-640">
      <!-- Subdued Pulse Ring (No Neon) -->
      <circle r="22" fill="#2563eb" fill-opacity="0.15" class="vehicle-pulse"/>
      
      <!-- Bus Pin Icon (Official Blue Circle with White Bus) -->
      <circle r="14" fill="#2563eb" stroke="#ffffff" stroke-width="2" filter="url(#subtleShadow)"/>
      <path
        d="M -6 4 L 6 4 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4 L -4 6 M 4 4 L 4 6"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="0.9" fill="#ffffff"/>
      <circle cx="3" cy="2" r="0.9" fill="#ffffff"/>

      <!-- Official Blue Line Badge Pill [640] -->
      <g transform="translate(18, -16)">
        <rect width="46" height="24" rx="7" fill="#2563eb" filter="url(#subtleShadow)"/>
        <text x="23" y="16" fill="#ffffff" font-size="13" font-weight="800" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" letter-spacing="-0.3">640</text>
      </g>
    </g>

    <!-- Moving Bus 300 (Secondary on Line 300) -->
    <g class="transit-vehicle-300">
      <circle r="11" fill="#1d4ed8" stroke="#ffffff" stroke-width="1.5" filter="url(#subtleShadow)"/>
      <path
        d="M -5 3 L 5 3 L 5 -4 C 5 -5 -5 -5 -5 -4 Z"
        stroke="#ffffff"
        stroke-width="1.1"
        fill="none"
      />
      <g transform="translate(15, -13)">
        <rect width="40" height="20" rx="6" fill="#1d4ed8" filter="url(#subtleShadow)"/>
        <text x="20" y="14" fill="#ffffff" font-size="11" font-weight="800" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif">300</text>
      </g>
    </g>
  </svg>
</div>
