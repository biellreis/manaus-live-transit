---
---
<div class="hero-transit-stage" aria-hidden="true">
  <!-- Clean Atmospheric Vignette -->
  <div class="transit-vignette-overlay"></div>

  <!-- Organized Geometric Transit Map of Manaus (1600x900) -->
  <svg class="transit-svg-canvas" viewBox="0 0 1600 900" fill="none" preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Official Corridors: Blue & Orange -->
      <linearGradient id="corridorBlue640" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.3"/>
        <stop offset="50%" stop-color="#2563eb" stop-opacity="1"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.9"/>
      </linearGradient>

      <linearGradient id="corridorBlue300" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e40af" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.8"/>
      </linearGradient>

      <linearGradient id="corridorOrangeVolta" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ea580c" stop-opacity="0.85"/>
        <stop offset="50%" stop-color="#f97316" stop-opacity="1"/>
        <stop offset="100%" stop-color="#fb923c" stop-opacity="0.4"/>
      </linearGradient>

      <!-- Physical Contact Shadow (No Neon) -->
      <filter id="busDropShadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#000000" flood-opacity="0.85"/>
      </filter>
    </defs>

    <!-- 1. WATER BODY: Rio Negro (Southern Shoreline) -->
    <path
      d="M -50 780 Q 400 810 850 790 T 1650 800 L 1650 950 L -50 950 Z"
      fill="#080c14"
    />
    <path
      d="M -50 780 Q 400 810 850 790 T 1650 800"
      stroke="#ffffff"
      stroke-width="1.5"
      stroke-opacity="0.12"
      fill="none"
    />
    <text x="1420" y="840" fill="#ffffff" fill-opacity="0.25" font-size="13" font-weight="700" letter-spacing="1">RIO NEGRO • PORTO</text>

    <!-- 2. ORGANIZED AVENUE GRID OF MANAUS (Clean Geometric Corridors) -->
    <g stroke="#ffffff" stroke-linecap="round">
      <!-- Main Avenues North-South (Constantino Nery, Djalma Batista, Getúlio Vargas, Mário Ypiranga) -->
      <path d="M 280 -40 L 330 220 L 420 440 L 520 620 L 680 770" stroke-width="2.5" stroke-opacity="0.12"/>
      <path d="M 680 -40 L 710 240 L 760 460 L 820 640 L 910 780" stroke-width="2.5" stroke-opacity="0.1"/>
      <path d="M 1040 -40 L 1070 260 L 1120 500 L 1170 700 L 1220 780" stroke-width="2" stroke-opacity="0.08"/>
      <path d="M 1360 -40 L 1380 300 L 1410 580 L 1440 780" stroke-width="1.8" stroke-opacity="0.06"/>

      <!-- Main Transversals (Darcy Vargas, Álvaro Maia, Leonardo Malcher, Sete de Setembro) -->
      <path d="M 100 240 L 1520 240" stroke-width="2" stroke-opacity="0.08"/>
      <path d="M 120 460 L 1540 460" stroke-width="2.5" stroke-opacity="0.1"/>
      <path d="M 200 620 L 1480 620" stroke-width="2" stroke-opacity="0.08"/>
      <path d="M 300 740 L 1400 740" stroke-width="2.5" stroke-opacity="0.12"/>
    </g>

    <!-- 3. OFFICIAL STATIONS & LANDMARKS (Only White, Blue and Orange) -->
    <!-- Terminal 1 (T1) Constantino Nery -->
    <g transform="translate(420, 440)">
      <circle r="14" fill="#2563eb" fill-opacity="0.15" stroke="#2563eb" stroke-width="2"/>
      <circle r="6" fill="#ffffff"/>
      <text x="-16" y="5" fill="#ffffff" font-size="13" font-weight="800" text-anchor="end">Terminal 1 (T1)</text>
      <text x="-16" y="20" fill="#ffffff" fill-opacity="0.6" font-size="11" text-anchor="end">Av. Constantino Nery</text>
    </g>

    <!-- Estação E1 São Jorge -->
    <g transform="translate(330, 220)">
      <circle r="5" fill="#ffffff" stroke="#2563eb" stroke-width="2.5"/>
      <text x="-14" y="4" fill="#ffffff" fill-opacity="0.7" font-size="11" font-weight="600" text-anchor="end">Estação E1</text>
    </g>

    <!-- Praça da Saudade -->
    <g transform="translate(520, 620)">
      <circle r="6" fill="#2563eb" stroke="#ffffff" stroke-width="2"/>
      <text x="-16" y="4" fill="#ffffff" font-size="12" font-weight="700" text-anchor="end">Praça da Saudade</text>
    </g>

    <!-- Matriz • Centro Histórico -->
    <g transform="translate(680, 770)">
      <circle r="8" fill="#ffffff" stroke="#2563eb" stroke-width="3"/>
      <text x="18" y="5" fill="#ffffff" font-size="13" font-weight="800">Matriz • Centro</text>
      <text x="18" y="20" fill="#ffffff" fill-opacity="0.6" font-size="11">Terminal Central</text>
    </g>

    <!-- 4. OFFICIAL TRANSIT CORRIDORS (Clean & Harmonious) -->
    <!-- Route 1: Linha 640 (Ida: Constantino Nery -> T1 -> Centro) -->
    <path
      id="cleanRoute640"
      d="M 280 -40 L 330 220 L 420 440 L 520 620 L 680 770"
      stroke="url(#corridorBlue640)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- Route 2: Linha 300 (Expresso Norte: Djalma Batista -> Centro) -->
    <path
      id="cleanRoute300"
      d="M 680 -40 L 710 240 L 760 460 L 820 640 L 910 780"
      stroke="url(#corridorBlue300)"
      stroke-width="4"
      stroke-dasharray="10 8"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- Route 3: Linha de Retorno (Volta: Centro -> Bairros em Laranja Oficial) -->
    <path
      id="cleanRouteVolta"
      d="M 720 780 L 860 620 L 1020 460 L 1070 260 L 1100 -40"
      stroke="url(#corridorOrangeVolta)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- 5. THREE UPRIGHT REAL-TIME BUSES (Never Tilt / Never Invert) -->
    <!-- BUS 1: Linha 640 (Azul Oficial) -->
    <g class="bus-unit-640">
      <circle r="24" fill="#2563eb" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="15" fill="#2563eb" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <!-- Crisp White Bus Icon -->
      <path
        d="M -6 4.5 L 6 4.5 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4.5 L -4 7 M 4 4.5 L 4 7"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="1" fill="#ffffff"/>
      <circle cx="3" cy="2" r="1" fill="#ffffff"/>
      <!-- Upright Badge 640 -->
      <g transform="translate(18, -16)">
        <rect width="48" height="24" rx="7" fill="#2563eb" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="24" y="16" fill="#ffffff" font-size="13" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif" letter-spacing="-0.3">640</text>
      </g>
    </g>

    <!-- BUS 2: Linha 300 (Azul Oficial) -->
    <g class="bus-unit-300">
      <circle r="22" fill="#3b82f6" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="14" fill="#3b82f6" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -5.5 4 L 5.5 4 L 5.5 -4.5 C 5.5 -6 -5.5 -6 -5.5 -4.5 Z M -5.5 -1 L 5.5 -1 M -3.5 4 L -3.5 6.5 M 3.5 4 L 3.5 6.5"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <circle cx="2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <!-- Upright Badge 300 -->
      <g transform="translate(18, -15)">
        <rect width="46" height="23" rx="7" fill="#3b82f6" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="23" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif">300</text>
      </g>
    </g>

    <!-- BUS 3: Linha 640 Volta (Laranja Oficial) -->
    <g class="bus-unit-volta">
      <circle r="24" fill="#f97316" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="15" fill="#f97316" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -6 4.5 L 6 4.5 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4.5 L -4 7 M 4 4.5 L 4 7"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="1" fill="#ffffff"/>
      <circle cx="3" cy="2" r="1" fill="#ffffff"/>
      <!-- Upright Badge Volta -->
      <g transform="translate(18, -16)">
        <rect width="52" height="24" rx="7" fill="#f97316" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="26" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif" letter-spacing="-0.3">VOLTA</text>
      </g>
    </g>
  </svg>
</div>
