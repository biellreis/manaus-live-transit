---
---
<div class="hero-transit-stage" aria-hidden="true">
  <!-- Atmospheric Vignette Mask for Perfect Text Contrast (Zero Neon) -->
  <div class="transit-vignette-overlay"></div>

  <!-- Full-Bleed 1440x900 Scalable Vector Canvas of Manaus Transit -->
  <svg class="transit-svg-canvas" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Official Bus Route Gradients -->
      <linearGradient id="heroRouteGrad640" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.3"/>
        <stop offset="40%" stop-color="#2563eb" stop-opacity="0.95"/>
        <stop offset="70%" stop-color="#3b82f6" stop-opacity="1"/>
        <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.7"/>
      </linearGradient>

      <linearGradient id="heroRouteGrad300" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2563eb" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.5"/>
      </linearGradient>

      <!-- Soft Physical Contact Shadow (No Neon) -->
      <filter id="heroSubtleShadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.8"/>
      </filter>
    </defs>

    <!-- Rio Negro Shoreline & Southern Coast of Manaus -->
    <path
      d="M -50 820 Q 300 860 650 830 T 1200 840 T 1500 810 L 1500 950 L -50 950 Z"
      fill="#0c1322"
      fill-opacity="0.35"
    />
    <path
      d="M -50 820 Q 300 860 650 830 T 1200 840 T 1500 810"
      stroke="#1e293b"
      stroke-width="2"
      stroke-opacity="0.4"
      fill="none"
    />

    <!-- Geographic Base Street Grid of Manaus -->
    <g class="manaus-streets" stroke="#ffffff" stroke-opacity="0.04" stroke-width="1.5">
      <!-- Av. Constantino Nery Main Corridor -->
      <path d="M 80 -40 L 260 210 L 440 410 L 610 560 L 780 670 L 960 740 L 1180 800" stroke-width="3" stroke-opacity="0.08"/>
      
      <!-- Av. Djalma Batista Parallel Axis -->
      <path d="M 320 -40 L 460 180 L 620 370 L 770 510 L 930 630 L 1110 720 L 1320 780" stroke-width="2.5" stroke-opacity="0.06"/>

      <!-- Av. Mário Ypiranga / Recife Axis -->
      <path d="M 580 -40 L 710 170 L 850 350 L 1000 490 L 1160 610 L 1340 700" stroke-opacity="0.04"/>

      <!-- Crossings: Av. Darcy Vargas -->
      <path d="M 120 420 L 890 220" stroke-width="2" stroke-opacity="0.06"/>
      <!-- Crossing: Av. Álvaro Maia (Boulevard) -->
      <path d="M 340 610 L 1120 410" stroke-width="2" stroke-opacity="0.06"/>
      <!-- Crossing: Rua Leonardo Malcher -->
      <path d="M 520 730 L 1260 550"/>
      <!-- Crossing: Av. 7 de Setembro -->
      <path d="M 680 810 L 1360 650"/>

      <!-- Centro Histórico Grid -->
      <circle cx="780" cy="670" r="55" stroke-opacity="0.06" fill="none"/>
      <path d="M 700 670 L 860 670"/>
      <path d="M 780 590 L 780 750"/>
      
      <!-- Praça da Matriz & Porto -->
      <circle cx="960" cy="740" r="35" stroke-opacity="0.06" fill="none"/>
    </g>

    <!-- Official Secondary Line: Linha 300 (Expresso Norte) -->
    <path
      id="hero-route-300"
      d="M 320 -20 Q 480 220 640 400 T 920 610 T 1150 730"
      stroke="url(#heroRouteGrad300)"
      stroke-width="2.5"
      stroke-dasharray="8 8"
      stroke-linecap="round"
      fill="none"
    />

    <!-- Primary Official Trunk Corridor: Linha 640 (T4 / T3 / E1 / T1 / Centro) -->
    <path
      id="hero-route-640"
      d="M 60 20 C 220 180, 320 300, 420 400 C 520 500, 620 570, 720 630 C 820 690, 910 720, 1020 750 C 1120 780, 1220 790, 1340 810"
      stroke="url(#heroRouteGrad640)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- Real Transit Hubs Along Corridor -->
    <!-- Estação E1 São Jorge -->
    <g class="stop-hub" transform="translate(420, 400)">
      <circle r="5" fill="#ffffff" stroke="#2563eb" stroke-width="2.5"/>
      <text x="14" y="4" fill="#94a3b8" font-size="12" font-weight="600" letter-spacing="0.4">E1 São Jorge</text>
    </g>

    <!-- Terminal 1 (T1) - Constantino Nery (Major Hub) -->
    <g class="stop-hub major-hub" transform="translate(720, 630)">
      <circle r="14" fill="#2563eb" fill-opacity="0.12"/>
      <circle r="7" fill="#ffffff" stroke="#2563eb" stroke-width="3"/>
      <text x="18" y="5" fill="#f8fafc" font-size="13" font-weight="700" letter-spacing="0.3">Terminal 1 (T1)</text>
      <text x="18" y="21" fill="#94a3b8" font-size="11">Av. Constantino Nery</text>
    </g>

    <!-- Praça da Saudade / Centro -->
    <g class="stop-hub" transform="translate(1020, 750)">
      <circle r="6" fill="#ffffff" stroke="#2563eb" stroke-width="2.5"/>
      <text x="-14" y="-12" fill="#94a3b8" font-size="12" font-weight="600" text-anchor="end">Praça da Saudade</text>
    </g>

    <!-- Praça da Matriz / Centro Histórico -->
    <g class="stop-hub" transform="translate(1220, 790)">
      <circle r="5" fill="#ffffff" stroke="#2563eb" stroke-width="2"/>
      <text x="14" y="4" fill="#94a3b8" font-size="11" font-weight="600">Matriz • Centro</text>
    </g>

    <!-- Moving Bus 640 Along Real Transit Path -->
    <g class="hero-bus-vehicle-640">
      <!-- Subdued Pulse Ring (No Neon) -->
      <circle r="26" fill="#2563eb" fill-opacity="0.15" class="vehicle-pulse"/>
      
      <!-- Bus Pin Icon (Official Blue Circle with White Bus) -->
      <circle r="16" fill="#2563eb" stroke="#ffffff" stroke-width="2.5" filter="url(#heroSubtleShadow)"/>
      <path
        d="M -7 5 L 7 5 L 7 -6 C 7 -7.5 -7 -7.5 -7 -6 Z M -7 -1 L 7 -1 M -5 5 L -5 7.5 M 5 5 L 5 7.5"
        stroke="#ffffff"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
      <circle cx="-3.5" cy="2.5" r="1" fill="#ffffff"/>
      <circle cx="3.5" cy="2.5" r="1" fill="#ffffff"/>

      <!-- Official Blue Line Badge Pill [640] -->
      <g transform="translate(20, -18)">
        <rect width="50" height="26" rx="8" fill="#2563eb" filter="url(#heroSubtleShadow)"/>
        <text x="25" y="18" fill="#ffffff" font-size="14" font-weight="800" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" letter-spacing="-0.4">640</text>
      </g>
    </g>

    <!-- Moving Bus 300 (Secondary on Line 300) -->
    <g class="hero-bus-vehicle-300">
      <circle r="12" fill="#1d4ed8" stroke="#ffffff" stroke-width="1.8" filter="url(#heroSubtleShadow)"/>
      <path
        d="M -5 3.5 L 5 3.5 L 5 -4.5 C 5 -5.5 -5 -5.5 -5 -4.5 Z"
        stroke="#ffffff"
        stroke-width="1.2"
        fill="none"
      />
      <g transform="translate(16, -15)">
        <rect width="44" height="22" rx="7" fill="#1d4ed8" filter="url(#heroSubtleShadow)"/>
        <text x="22" y="15" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif">300</text>
      </g>
    </g>
  </svg>
</div>
