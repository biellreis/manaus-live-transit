---
---
<div class="hero-transit-stage" aria-hidden="true">
  <!-- Clean Atmospheric Vignette -->
  <div class="transit-vignette-overlay"></div>

  <!-- Organized Geometric Transit Map of Manaus (1600x900) -->
  <svg class="transit-svg-canvas" viewBox="0 0 1600 900" fill="none" preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Official Corridors: Blue & Orange -->
      <linearGradient id="corridorBlue120" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e40af" stop-opacity="0.3"/>
        <stop offset="50%" stop-color="#2563eb" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.9"/>
      </linearGradient>

      <linearGradient id="corridorBlue640" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.35"/>
        <stop offset="50%" stop-color="#2563eb" stop-opacity="1"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.95"/>
      </linearGradient>

      <linearGradient id="corridorBlue300" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e40af" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.85"/>
      </linearGradient>

      <linearGradient id="corridorOrange448" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ea580c" stop-opacity="0.85"/>
        <stop offset="50%" stop-color="#f97316" stop-opacity="1"/>
        <stop offset="100%" stop-color="#fb923c" stop-opacity="0.4"/>
      </linearGradient>

      <linearGradient id="corridorBlue652" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e40af" stop-opacity="0.35"/>
        <stop offset="50%" stop-color="#2563eb" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.9"/>
      </linearGradient>

      <linearGradient id="corridorOrange560" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ea580c" stop-opacity="0.4"/>
        <stop offset="50%" stop-color="#f97316" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#ea580c" stop-opacity="0.85"/>
      </linearGradient>

      <!-- Physical Contact Shadow (No Neon) -->
      <filter id="busDropShadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#000000" flood-opacity="0.85"/>
      </filter>
    </defs>

    <!-- 1. WATER BODY: Rio Negro (Southern Shoreline) -->
    <path
      d="M -50 820 Q 400 850 850 830 T 1650 835 L 1650 950 L -50 950 Z"
      fill="#080c14"
    />
    <path
      d="M -50 820 Q 400 850 850 830 T 1650 835"
      stroke="#ffffff"
      stroke-width="1.5"
      stroke-opacity="0.14"
      fill="none"
    />
    <text x="1420" y="870" fill="#ffffff" fill-opacity="0.25" font-size="12" font-weight="700" letter-spacing="1.5">RIO NEGRO • PORTO DE MANAUS</text>

    <!-- 2. ORGANIZED AVENUE NETWORK (Vertical & Diagonal Corridors - NO HORIZONTAL LINES) -->
    <g stroke="#ffffff" stroke-linecap="round">
      <!-- Flanco Oeste: Av. Cel. Teixeira / Ponta Negra / São Jorge -->
      <path d="M 80 -40 L 90 200 L 130 450 L 180 700 L 260 840" stroke-width="2" stroke-opacity="0.08"/>
      <!-- Centro-Oeste: Av. Brasil / Compensa -->
      <path d="M 220 -40 L 250 250 L 320 500 L 420 720 L 520 830" stroke-width="2" stroke-opacity="0.07"/>
      <!-- Eixo Central 1: Av. Constantino Nery -->
      <path d="M 360 -40 L 390 220 L 460 440 L 540 640 L 680 770" stroke-width="2.5" stroke-opacity="0.1"/>
      <!-- Eixo Central 2: Av. Djalma Batista -->
      <path d="M 720 -40 L 750 240 L 800 480 L 860 660 L 920 780" stroke-width="2.5" stroke-opacity="0.1"/>
      <!-- Centro-Leste: Av. Mário Ypiranga / Paraíba -->
      <path d="M 1080 -40 L 1110 260 L 1150 500 L 1180 720 L 1200 820" stroke-width="2" stroke-opacity="0.08"/>
      <!-- Flanco Leste 1: Av. Ephigênio Salles / Coroado -->
      <path d="M 1320 -40 L 1340 240 L 1370 480 L 1400 700 L 1420 830" stroke-width="2.2" stroke-opacity="0.08"/>
      <!-- Flanco Leste 2: Av. Autaz Mirim / Grande Circular -->
      <path d="M 1520 -40 L 1490 220 L 1460 460 L 1430 680 L 1390 840" stroke-width="2" stroke-opacity="0.07"/>
    </g>

    <!-- 3. OFFICIAL HUBS & STATIONS (White, Blue, Orange) -->
    <!-- Estação Ponta Negra (Flanco Oeste) -->
    <g transform="translate(90, 200)">
      <circle r="6" fill="#ffffff" stroke="#2563eb" stroke-width="2"/>
      <text x="14" y="4" fill="#ffffff" font-size="11" font-weight="700">Ponta Negra</text>
      <text x="14" y="16" fill="#ffffff" fill-opacity="0.55" font-size="10">Zona Oeste</text>
    </g>

    <!-- Estação São Jorge (Flanco Oeste) -->
    <g transform="translate(130, 450)">
      <circle r="5" fill="#2563eb" stroke="#ffffff" stroke-width="1.8"/>
      <text x="14" y="4" fill="#ffffff" font-size="11" font-weight="600">São Jorge</text>
    </g>

    <!-- Terminal 1 (T1) Constantino Nery -->
    <g transform="translate(460, 440)">
      <circle r="14" fill="#2563eb" fill-opacity="0.18" stroke="#2563eb" stroke-width="2"/>
      <circle r="6" fill="#ffffff"/>
      <text x="-16" y="5" fill="#ffffff" font-size="13" font-weight="800" text-anchor="end">Terminal 1 (T1)</text>
      <text x="-16" y="20" fill="#ffffff" fill-opacity="0.6" font-size="11" text-anchor="end">Av. Constantino Nery</text>
    </g>

    <!-- Praça da Saudade -->
    <g transform="translate(540, 640)">
      <circle r="6" fill="#2563eb" stroke="#ffffff" stroke-width="2"/>
      <text x="-16" y="4" fill="#ffffff" font-size="12" font-weight="700" text-anchor="end">Praça da Saudade</text>
    </g>

    <!-- Matriz • Centro Histórico -->
    <g transform="translate(680, 770)">
      <circle r="8" fill="#ffffff" stroke="#2563eb" stroke-width="3"/>
      <text x="18" y="5" fill="#ffffff" font-size="13" font-weight="800">Matriz • Centro</text>
      <text x="18" y="20" fill="#ffffff" fill-opacity="0.6" font-size="11">Terminal Central</text>
    </g>

    <!-- Coroado • V8 (Flanco Leste) -->
    <g transform="translate(1340, 240)">
      <circle r="6" fill="#2563eb" stroke="#ffffff" stroke-width="2"/>
      <text x="-14" y="4" fill="#ffffff" font-size="11" font-weight="700" text-anchor="end">Coroado • V8</text>
      <text x="-14" y="16" fill="#ffffff" fill-opacity="0.55" font-size="10" text-anchor="end">Av. Ephigênio Salles</text>
    </g>

    <!-- Terminal 4 (T4) Jorge Teixeira (Flanco Leste) -->
    <g transform="translate(1490, 220)">
      <circle r="13" fill="#f97316" fill-opacity="0.18" stroke="#f97316" stroke-width="2"/>
      <circle r="6" fill="#ffffff"/>
      <text x="-16" y="5" fill="#ffffff" font-size="12" font-weight="800" text-anchor="end">Terminal 4 (T4)</text>
      <text x="-16" y="18" fill="#ffffff" fill-opacity="0.6" font-size="10" text-anchor="end">Zona Leste</text>
    </g>

    <!-- Distrito Industrial (Flanco Leste) -->
    <g transform="translate(1430, 680)">
      <circle r="5.5" fill="#f97316" stroke="#ffffff" stroke-width="1.8"/>
      <text x="-14" y="4" fill="#ffffff" font-size="11" font-weight="700" text-anchor="end">Distrito Industrial</text>
    </g>

    <!-- 4. OFFICIAL TRANSIT CORRIDORS (Clean Vector Paths) -->
    <!-- ROTA 1: Linha 120 (Flanco Oeste: Ponta Negra -> São Jorge -> Centro) -->
    <path
      id="cleanRoute120"
      d="M 80 -40 L 90 200 L 130 450 L 180 700 L 260 840"
      stroke="url(#corridorBlue120)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- ROTA 2: Linha 640 (Centro-Oeste: Constantino Nery -> T1 -> Centro) -->
    <path
      id="cleanRoute640"
      d="M 360 -40 L 390 220 L 460 440 L 540 640 L 680 770"
      stroke="url(#corridorBlue640)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- ROTA 3: Linha 300 (Centro: Expresso Djalma Batista -> Centro) -->
    <path
      id="cleanRoute300"
      d="M 720 -40 L 750 240 L 800 480 L 860 660 L 920 780"
      stroke="url(#corridorBlue300)"
      stroke-width="4"
      stroke-dasharray="10 8"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- ROTA 4: Linha 448 (Centro-Leste: Centro -> Cidade Nova / Retorno) -->
    <path
      id="cleanRoute448"
      d="M 700 780 L 820 620 L 940 440 L 990 220 L 1020 -40"
      stroke="url(#corridorOrange448)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- ROTA 5: Linha 652 (Flanco Leste: V8 / Coroado -> Centro) -->
    <path
      id="cleanRoute652"
      d="M 1320 -40 L 1340 240 L 1370 480 L 1400 700 L 1420 830"
      stroke="url(#corridorBlue652)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- ROTA 6: Linha 560 (Flanco Leste: T4 -> Distrito Industrial / Leste) -->
    <path
      id="cleanRoute560"
      d="M 1520 -40 L 1490 220 L 1460 460 L 1430 680 L 1390 840"
      stroke="url(#corridorOrange560)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />

    <!-- 5. SIX UPRIGHT REAL-TIME BUSES WITH NUMBERS (100% Horizontal & Upright) -->
    <!-- ÔNIBUS 1: Linha 120 (Flanco Oeste • Azul) -->
    <g class="bus-unit-120">
      <circle r="22" fill="#2563eb" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="14" fill="#2563eb" stroke="#ffffff" stroke-width="2.2" filter="url(#busDropShadow)"/>
      <path
        d="M -5.5 4 L 5.5 4 L 5.5 -4.5 C 5.5 -6 -5.5 -6 -5.5 -4.5 Z M -5.5 -1 L 5.5 -1 M -3.5 4 L -3.5 6.5 M 3.5 4 L 3.5 6.5"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <circle cx="2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <g transform="translate(18, -15)">
        <rect width="46" height="23" rx="7" fill="#2563eb" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="23" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif">120</text>
      </g>
    </g>

    <!-- ÔNIBUS 2: Linha 640 (Centro-Oeste • Azul) -->
    <g class="bus-unit-640">
      <circle r="24" fill="#2563eb" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="15" fill="#2563eb" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -6 4.5 L 6 4.5 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4.5 L -4 7 M 4 4.5 L 4 7"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="1" fill="#ffffff"/>
      <circle cx="3" cy="2" r="1" fill="#ffffff"/>
      <g transform="translate(18, -16)">
        <rect width="48" height="24" rx="7" fill="#2563eb" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="24" y="16" fill="#ffffff" font-size="13" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif" letter-spacing="-0.3">640</text>
      </g>
    </g>

    <!-- ÔNIBUS 3: Linha 300 (Centro • Azul) -->
    <g class="bus-unit-300">
      <circle r="22" fill="#3b82f6" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="14" fill="#3b82f6" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -5.5 4 L 5.5 4 L 5.5 -4.5 C 5.5 -6 -5.5 -6 -5.5 -4.5 Z M -5.5 -1 L 5.5 -1 M -3.5 4 L -3.5 6.5 M 3.5 4 L 3.5 6.5"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <circle cx="2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <g transform="translate(18, -15)">
        <rect width="46" height="23" rx="7" fill="#3b82f6" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="23" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif">300</text>
      </g>
    </g>

    <!-- ÔNIBUS 4: Linha 448 (Centro-Leste • Laranja Oficial) -->
    <g class="bus-unit-448">
      <circle r="24" fill="#f97316" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="15" fill="#f97316" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -6 4.5 L 6 4.5 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4.5 L -4 7 M 4 4.5 L 4 7"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="1" fill="#ffffff"/>
      <circle cx="3" cy="2" r="1" fill="#ffffff"/>
      <g transform="translate(18, -16)">
        <rect width="48" height="24" rx="7" fill="#f97316" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="24" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif" letter-spacing="-0.3">448</text>
      </g>
    </g>

    <!-- ÔNIBUS 5: Linha 652 (Flanco Leste • Azul) -->
    <g class="bus-unit-652">
      <circle r="22" fill="#2563eb" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="14" fill="#2563eb" stroke="#ffffff" stroke-width="2.2" filter="url(#busDropShadow)"/>
      <path
        d="M -5.5 4 L 5.5 4 L 5.5 -4.5 C 5.5 -6 -5.5 -6 -5.5 -4.5 Z M -5.5 -1 L 5.5 -1 M -3.5 4 L -3.5 6.5 M 3.5 4 L 3.5 6.5"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <circle cx="2.5" cy="1.8" r="0.9" fill="#ffffff"/>
      <g transform="translate(18, -15)">
        <rect width="46" height="23" rx="7" fill="#2563eb" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="23" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif">652</text>
      </g>
    </g>

    <!-- ÔNIBUS 6: Linha 560 (Flanco Leste • Laranja Oficial) -->
    <g class="bus-unit-560">
      <circle r="24" fill="#f97316" fill-opacity="0.2" class="bus-pulse"/>
      <circle r="15" fill="#f97316" stroke="#ffffff" stroke-width="2.5" filter="url(#busDropShadow)"/>
      <path
        d="M -6 4.5 L 6 4.5 L 6 -5 C 6 -6.5 -6 -6.5 -6 -5 Z M -6 -1 L 6 -1 M -4 4.5 L -4 7 M 4 4.5 L 4 7"
        stroke="#ffffff"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="-3" cy="2" r="1" fill="#ffffff"/>
      <circle cx="3" cy="2" r="1" fill="#ffffff"/>
      <g transform="translate(18, -16)">
        <rect width="48" height="24" rx="7" fill="#f97316" stroke="#ffffff" stroke-width="1" filter="url(#busDropShadow)"/>
        <text x="24" y="16" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle" font-family="-apple-system, SF Pro Text, sans-serif" letter-spacing="-0.3">560</text>
      </g>
    </g>
  </svg>
</div>
