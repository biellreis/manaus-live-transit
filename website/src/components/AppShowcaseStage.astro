---
import Phone from './Phone.astro';
---

<section class="apple-showcase-section" id="aplicativo" aria-labelledby="aplicativo-heading">
  <div class="apple-container showcase-wide-container">
    <!-- Header Minimalista e Direto (Inspirado no 99app.com) -->
    <div class="apple-section-header showcase-header">
      <span class="showcase-eyebrow">O APLICATIVO</span>
      <h2 id="aplicativo-heading" class="apple-section-headline">
        O transporte de Manaus na sua mão.
      </h2>
      <p class="apple-section-subhead">
        Acompanhe itinerários em tempo real e saiba o minuto exato de ir para a parada.
      </p>
    </div>

    <!-- BLOCO 1: PALCO PRINCIPAL SPLIT-STAGE (ESTILO 99 + APPLE) -->
    <div class="showcase-split-stage">
      <!-- Coluna da Esquerda: Narrativa e Seletores Interativos -->
      <div class="showcase-split-narrative">
        <div class="showcase-tabs-menu" role="tablist" aria-label="Selecione o modo de visualização">
          <!-- Tab 1: Rastreamento Ao Vivo -->
          <button type="button" class="stage-tab-card active" data-stage-tab="journey" role="tab" aria-selected="true">
            <div class="tab-card-top">
              <span class="tab-index-badge">01</span>
              <span class="tab-status-chip blue">Ao Vivo</span>
            </div>
            <strong class="tab-card-title">Rastreamento GPS em Tempo Real</strong>
            <p class="tab-card-desc">
              Veja a linha 640 e outros ônibus se movimentando pelo mapa segundo a segundo com precisão métrica.
            </p>
          </button>

          <!-- Tab 2: Visão Geral das Linhas -->
          <button type="button" class="stage-tab-card" data-stage-tab="home" role="tab" aria-selected="false">
            <div class="tab-card-top">
              <span class="tab-index-badge">02</span>
              <span class="tab-status-chip orange">240+ Linhas</span>
            </div>
            <strong class="tab-card-title">Catálogo Completo da Cidade</strong>
            <p class="tab-card-desc">
              Busca instantânea por número de linha, itinerários, paradas próximas e terminais de integração.
            </p>
          </button>
        </div>

        <div class="showcase-telemetry-pill">
          <span class="pulse-dot"></span>
          <span>Telemetria ativa &bull; Latência &lt; 850ms via SSE</span>
        </div>
      </div>

      <!-- Coluna da Direita: iPhone 16 Pro Flagship em Destaque -->
      <div class="showcase-split-device">
        <div class="phone-chassis-stage">
          <div class="phone-wrapper">
            <Phone screen="journey" id="showcasePhoneDisplay" label="Tela do aplicativo Manô em execução no iPhone 16 Pro" eager={true} />
          </div>
          <div class="phone-ground-shadow" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- BLOCO 2: GRADE MODULAR DE 3 BENEFÍCIOS (ESTILO 99APP) -->
    <div class="showcase-benefits-grid">
      <!-- Card 1: Telemetria Sub-segundo -->
      <div class="benefit-card">
        <div class="benefit-card-tag blue">VELOCIDADE &bull; SENTIDO</div>
        <h3 class="benefit-card-title">Precisão de 3 Metros</h3>
        <p class="benefit-card-desc">
          Telemetria direta sem estimativas genéricas. Acompanhe velocidade em km/h, sentido e distância da parada.
        </p>
        <div class="benefit-card-foot">
          <span class="benefit-chip">Veículo #640-12</span>
          <span class="benefit-chip-sub">44 km/h</span>
        </div>
      </div>

      <!-- Card 2: Radar de Estação & Faixa BRS -->
      <div class="benefit-card">
        <div class="benefit-card-tag orange">CORREDOR BRS &bull; ESTAÇÃO E2</div>
        <h3 class="benefit-card-title">Previsão em 3 Minutos</h3>
        <p class="benefit-card-desc">
          Alertas de aproximação nas plataformas da Constantino Nery com faixa exclusiva monitorada em tempo real.
        </p>
        <div class="benefit-card-foot">
          <span class="benefit-chip">Arena da Amazônia</span>
          <span class="benefit-chip-sub">Faixa Exclusiva</span>
        </div>
      </div>

      <!-- Card 3: 5 Terminais Integrados -->
      <div class="benefit-card">
        <div class="benefit-card-tag blue">REDE MUNICIPAL</div>
        <h3 class="benefit-card-title">T1 ao T5 Integrados</h3>
        <p class="benefit-card-desc">
          Partidas e chegadas dos 5 terminais urbanos integrados sem atrasos, com alertas de tráfego instantâneos.
        </p>
        <div class="benefit-card-foot">
          <span class="benefit-chip">Terminais 1 a 5</span>
          <span class="benefit-chip-sub">Operação Normal</span>
        </div>
      </div>
    </div>

    <!-- BLOCO 3: FAIXA DE MÉTRICAS DE AUTORIDADE -->
    <div class="showcase-metrics-bar">
      <div class="metric-block">
        <strong class="metric-number">240+</strong>
        <span class="metric-label">Linhas Mapeadas</span>
      </div>
      <div class="metric-separator" aria-hidden="true"></div>
      <div class="metric-block">
        <strong class="metric-number">5</strong>
        <span class="metric-label">Terminais Integrados</span>
      </div>
      <div class="metric-separator" aria-hidden="true"></div>
      <div class="metric-block">
        <strong class="metric-number">&lt; 850<small>ms</small></strong>
        <span class="metric-label">Latência GPS</span>
      </div>
      <div class="metric-separator" aria-hidden="true"></div>
      <div class="metric-block">
        <strong class="metric-number">100%</strong>
        <span class="metric-label">Gratuito e Sem Anúncios</span>
      </div>
    </div>
  </div>
</section>
