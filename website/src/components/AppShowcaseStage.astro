---
---

<section class="showcase-carousel-section" id="aplicativo" aria-labelledby="aplicativo-heading">
  <!-- FAIXA DE FUNDO: TOPO BRANCO / CLARO COM FAIXA AZUL ROYAL NA BASE (ESTILO 99 CARROSSEL) -->
  <div class="carousel-split-bg">
    <div class="bg-upper-white"></div>
    <div class="bg-lower-blue"></div>
  </div>

  <div class="apple-container carousel-stage-container">
    <!-- MEGA-CARD FLUTUANTE BRANCO COM CANTOS CURVADOS (ESTILO 99APP EXATO) -->
    <div class="carousel-floating-card" id="showcaseCarousel">
      <!-- SLIDE 1: TELEMETRIA GPS -->
      <div class="carousel-slide active" data-slide="0" role="tabpanel" aria-label="Slide 1 de 3">
        <div class="slide-copy-col">
          <span class="slide-eyebrow">TECNOLOGIA VEICULAR</span>
          <h2 id="aplicativo-heading" class="slide-headline">
            Telemetria GPS em tempo real
          </h2>
          <p class="slide-desc">
            Monitore a <strong>localização exata dos ônibus de Manaus</strong> direto no mapa. Veja paradas ativas, velocidade e previsão de chegada com <strong>precisão métrica de satélite</strong>.
          </p>
          <div class="slide-action-row">
            <a href="#instalar" class="btn-99-dark-pill" aria-label="Ver linhas e itinerários">
              <span class="btn-99-label">Ver linhas no mapa</span>
              <span class="btn-99-arrow-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <div class="slide-media-col">
          <div class="media-shape-backdrop shape-blue">
            <div class="slide-photo-frame">
              <img 
                src="/images/card_inside_bus.webp" 
                alt="Passageiro acompanhando o itinerário com tranquilidade no ônibus climatizado em Manaus" 
                class="slide-photo-img" 
                width="540" 
                height="400" 
                loading="eager" 
              />
              <div class="media-floating-badge">
                <span class="pulse-dot"></span>
                <span>GPS Manaus &bull; Ônibus Climatizado</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 2: TERMINAIS 1 AO 6 E ESTAÇÕES -->
      <div class="carousel-slide" data-slide="1" role="tabpanel" aria-label="Slide 2 de 3">
        <div class="slide-copy-col">
          <span class="slide-eyebrow">INTEGRAÇÃO METROPOLITANA</span>
          <h2 class="slide-headline">
            Terminais 1 ao 6 e estações integradas
          </h2>
          <p class="slide-desc">
            Planeje conexões e baldeações com facilidade no <strong>T1, T2, T3, T4, T5, T6</strong> e nas Estações de Transferência. Consulte itinerários e <strong>embarque sem perder tempo</strong>.
          </p>
          <div class="slide-action-row">
            <a href="#terminais" class="btn-99-dark-pill" aria-label="Consultar terminais de Manaus">
              <span class="btn-99-label">Ver todos os terminais</span>
              <span class="btn-99-arrow-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <div class="slide-media-col">
          <div class="media-shape-backdrop shape-orange">
            <div class="slide-photo-frame">
              <img 
                src="/images/card_terminal.webp" 
                alt="Terminais de ônibus integrados de Manaus" 
                class="slide-photo-img" 
                width="540" 
                height="400" 
                loading="lazy" 
              />
              <div class="media-floating-badge">
                <span class="pulse-dot"></span>
                <span>T1 ao T6 &bull; Conexões Rápidas</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SLIDE 3: PREVISÃO EXATA -->
      <div class="carousel-slide" data-slide="2" role="tabpanel" aria-label="Slide 3 de 3">
        <div class="slide-copy-col">
          <span class="slide-eyebrow">TRANQUILIDADE E PREVISÃO</span>
          <h2 class="slide-headline">
            Chega de esperar no escuro na parada
          </h2>
          <p class="slide-desc">
            Saiba o <strong>minuto exato de ir para o ponto</strong>. Alertas operacionais inteligentes e estimativa de chegada para você nunca mais <strong>ficar vulnerável na rua</strong>.
          </p>
          <div class="slide-action-row">
            <a href="#instalar" class="btn-99-dark-pill" aria-label="Instalar aplicativo Manô agora">
              <span class="btn-99-label">Instalar aplicativo</span>
              <span class="btn-99-arrow-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <div class="slide-media-col">
          <div class="media-shape-backdrop shape-blue">
            <div class="slide-photo-frame">
              <img 
                src="/images/card_bus_stop.webp" 
                alt="Passageira aguardando com previsibilidade na parada" 
                class="slide-photo-img" 
                width="540" 
                height="400" 
                loading="lazy" 
              />
              <div class="media-floating-badge">
                <span class="pulse-dot"></span>
                <span>Linha 123 &bull; A caminho</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- INDICADORES DE CARROSSEL 99 NA FAIXA AZUL -->
    <div class="carousel-nav-indicators" role="tablist" aria-label="Controle de slides do carrossel">
      <button type="button" class="carousel-dot active" data-slide-target="0" role="tab" aria-selected="true" aria-label="Slide 1: Telemetria GPS"></button>
      <button type="button" class="carousel-dot" data-slide-target="1" role="tab" aria-selected="false" aria-label="Slide 2: Terminais 1 ao 6"></button>
      <button type="button" class="carousel-dot" data-slide-target="2" role="tab" aria-selected="false" aria-label="Slide 3: Previsão Exata"></button>
    </div>

    <!-- BLOCO DE 4 INFORMAÇÕES CHAMATIVAS E VERDADEIRAS (TAMANHO EQUILIBRADO) -->
    <div class="carousel-metrics-bar">
      <div class="metric-item">
        <strong class="metric-value">Zero Espera no Escuro</strong>
        <span class="metric-label">Saiba o minuto exato de ir para a parada</span>
      </div>
      <div class="metric-item">
        <strong class="metric-value">100% Gratuito</strong>
        <span class="metric-label">Sem cadastro, sem mensalidade e sem anúncios</span>
      </div>
      <div class="metric-item">
        <strong class="metric-value">Menos de 3MB</strong>
        <span class="metric-label">Super leve: não trava nem consome seu 4G</span>
      </div>
      <div class="metric-item">
        <strong class="metric-value">GPS em Tempo Real</strong>
        <span class="metric-label">Localização exata de cada ônibus no mapa</span>
      </div>
    </div>
  </div>
</section>

<script>
  function setupShowcaseCarousel() {
    const carousel = document.getElementById('showcaseCarousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
    const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-nav-indicators .carousel-dot');
    let currentIndex = 0;
    let autoInterval: number | null = null;

    function goToSlide(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.add('active');
          slide.setAttribute('aria-hidden', 'false');
        } else {
          slide.classList.remove('active');
          slide.setAttribute('aria-hidden', 'true');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('active');
          dot.setAttribute('aria-selected', 'true');
        } else {
          dot.classList.remove('active');
          dot.setAttribute('aria-selected', 'false');
        }
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-slide-target') || '0', 10);
        goToSlide(target);
        resetAutoTimer();
      });
    });

    function startAutoTimer() {
      if (autoInterval) clearInterval(autoInterval);
      autoInterval = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5500);
    }

    function resetAutoTimer() {
      startAutoTimer();
    }

    carousel.addEventListener('mouseenter', () => {
      if (autoInterval) clearInterval(autoInterval);
    });

    carousel.addEventListener('mouseleave', () => {
      startAutoTimer();
    });

    startAutoTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShowcaseCarousel);
  } else {
    setupShowcaseCarousel();
  }
</script>
