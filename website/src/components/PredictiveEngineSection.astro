---
---

<section class="apple-bento-section" id="motor-preditivo" aria-labelledby="motor-preditivo-heading">
  <div class="apple-container">
    <div class="apple-section-header">
      <p class="apple-eyebrow-accent">ARQUITETURA DE DADOS</p>
      <h2 id="motor-preditivo-heading" class="apple-section-headline">
        Motor Preditivo em Tempo Real.<br/>
        <span class="apple-headline-gradient">Velocidade levada ao extremo.</span>
      </h2>
      <p class="apple-section-subhead">
        Desenvolvido para eliminar a incerteza nos pontos de ônibus de Manaus. Sincronização direta de telemetria GPS com cálculo dinâmico de chegada e sucessão contínua de veículos.
      </p>
    </div>

    <!-- Apple-style Bento Grid with App Images and Punchy Info -->
    <div class="apple-bento-grid">
      <!-- Card 1: Live Telemetry Radar & GPS Lock (Span 2) -->
      <div class="bento-card bento-card-span-2 bento-image-card">
        <div class="bento-card-content">
          <span class="bento-badge">TELEMETRIA CONTÍNUA</span>
          <h3 class="bento-title">&lt; 1s de latência</h3>
          <p class="bento-short-sub">Posição, velocidade vetorial e sentido da frota ao vivo.</p>
        </div>
        <div class="bento-img-container">
          <img
            src="/images/bento/bento_telemetry_gps.webp"
            alt="Telemetria e GPS da Linha 640"
            class="bento-app-crop-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Card 2: Smart Next-Bus Succession -->
      <div class="bento-card bento-image-card">
        <div class="bento-card-content">
          <span class="bento-badge">SUCESSÃO AUTOMÁTICA</span>
          <h3 class="bento-title">Próximo Ônibus</h3>
          <p class="bento-short-sub">Atualização instantânea após o veículo passar.</p>
        </div>
        <div class="bento-img-container">
          <img
            src="/images/bento/bento_succession.webp"
            alt="Sucessão do próximo ônibus em tempo real"
            class="bento-app-crop-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Card 3: 34 Georeferenced Stations -->
      <div class="bento-card bento-image-card">
        <div class="bento-card-content">
          <span class="bento-badge">CORREDORES EXPRESSOS</span>
          <h3 class="bento-title">34 Paradas</h3>
          <p class="bento-short-sub">Corredores Constantino Nery e Djalma Batista.</p>
        </div>
        <div class="bento-img-container">
          <img
            src="/images/bento/bento_stations_34.webp"
            alt="34 paradas mapeadas nos corredores"
            class="bento-app-crop-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Card 4: Dynamic Real-Time ETA (Span 2) -->
      <div class="bento-card bento-card-span-2 bento-image-card">
        <div class="bento-card-content">
          <span class="bento-badge">PRECISÃO DE CHEGADA</span>
          <h3 class="bento-title">ETA Dinâmico em Tempo Real</h3>
          <p class="bento-short-sub">Tráfego ao vivo e contagem de minutos até a sua parada.</p>
        </div>
        <div class="bento-img-container">
          <img
            src="/images/bento/bento_eta_calc.webp"
            alt="Cálculo de tempo de chegada dinâmico"
            class="bento-app-crop-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
