---
import { installUrl } from '../config';
---

<section class="apple-hero-stage" id="heroStage" aria-labelledby="hero-title">
  <!-- Apple Luminaire & Vertical Cone Beam -->
  <div class="apple-hero-lamp" aria-hidden="true">
    <div class="apple-hero-lamp-hex"></div>
  </div>
  <div class="apple-hero-spotlight" aria-hidden="true"></div>
  <div class="apple-hero-ambient-glow" aria-hidden="true"></div>

  <!-- Vignette overlay for cinema contrast -->
  <div class="apple-hero-vignette" aria-hidden="true"></div>

  <!-- Giant Metallic 3D "MANÔ" Letters Backdrop (Liquid Titanium Specular Sheen) -->
  <div class="apple-hero-backdrop-word" aria-hidden="true">
    <span class="chrome-letter">M</span>
    <span class="chrome-letter">A</span>
    <span class="chrome-letter">N</span>
    <span class="chrome-letter">Ô</span>
  </div>

  <!-- 3D iPhone Emergence & Interactive Pointer Tracking Stage -->
  <div class="apple-hero-viewport" id="heroViewport">
    <!-- Contact Floor Shadow with dynamic blur and spread -->
    <div class="apple-hero-floor-shadow" id="heroFloorShadow" aria-hidden="true"></div>

    <!-- 3D Transform Pivot with spring physics -->
    <div class="apple-phone-rig" id="heroPhoneRig">
      <div class="apple-pro-device" aria-hidden="true">
        <!-- Titanium Grade 5 Unibody Chassis -->
        <div class="device-titanium-bezel"></div>
        <div class="device-chamfer-rim"></div>

        <!-- Laser-cut Antenna Bands -->
        <span class="band band-tl"></span>
        <span class="band band-tr"></span>
        <span class="band band-bl"></span>
        <span class="band band-br"></span>

        <!-- Precision Hardware Buttons with Micro-Shadows -->
        <div class="btn-action" title="Action Button"></div>
        <div class="btn-vol-up" title="Aumentar Volume"></div>
        <div class="btn-vol-down" title="Diminuir Volume"></div>
        <div class="btn-power" title="Botão Lateral"></div>

        <!-- Earpiece Micro-Mesh -->
        <div class="device-earpiece"></div>

        <!-- Bezel & Super Retina XDR OLED Display -->
        <div class="device-screen-frame">
          <!-- Dynamic Island Pro -->
          <div class="device-dynamic-island">
            <div class="island-camera-lens">
              <span class="lens-specular-dot"></span>
            </div>
            <div class="island-sensor-dot"></div>
          </div>

          <!-- Dynamic Glass Glare Sweep (Moves with cursor) -->
          <div class="device-glass-glare" id="heroGlassGlare"></div>
          <div class="device-glass-sheen"></div>

          <!-- High-Resolution Screen Image -->
          <div class="device-screen-content">
            <img
              src="/screens/ida.webp"
              width="768"
              height="1670"
              alt="Manô - Linha 640 e Trajeto em Tempo Real"
              class="device-screen-img"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <!-- Apple-grade Spatial Floating Badges -->
        <div class="apple-spatial-badge badge-eta" id="heroBadgeEta">
          <span class="badge-bus-num">640</span>
          <div class="badge-body">
            <div class="badge-heading">
              <span class="pulse-indicator"></span>
              <strong>Chegando em 3 min</strong>
            </div>
            <span class="badge-meta">Próximo da sua parada • T1</span>
          </div>
        </div>

        <div class="apple-spatial-badge badge-fleet" id="heroBadgeFleet">
          <span class="badge-fleet-pill">13</span>
          <div class="badge-body">
            <strong>Ônibus Ativos</strong>
            <span class="badge-meta">Linha 640 em circulação</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Apple Canonical Bottom Billboard Lockup (Typography Left, Frosted Pill Right) -->
  <div class="apple-hero-billboard">
    <div class="apple-hero-billboard-left">
      <p class="apple-hero-eyebrow">MANÔ TRANSIT</p>
      <h1 id="hero-title" class="apple-hero-title">
        O tempo real.<br/>
        <span class="apple-hero-accent">Levado a sério.</span>
      </h1>
      <p class="apple-hero-sub">
        Monitore linhas, ônibus e paradas de Manaus sem atrasos.
      </p>
    </div>

    <div class="apple-hero-billboard-right">
      <div class="apple-hero-pricing-pill">
        <div class="pricing-pill-text">
          <strong class="pricing-headline">100% gratuito • PWA nativo</strong>
          <span class="pricing-sub">Instale no iPhone ou baixe o APK para Android</span>
        </div>
        <div class="pricing-pill-actions">
          <a href={installUrl('ios')} class="apple-pill-btn apple-pill-blue" data-install="ios" aria-label="Instalar no celular">
            Instalar
          </a>
          <a href="#destaques" class="apple-pill-btn apple-pill-ghost" aria-label="Explorar destaques">
            Explorar
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Subtle Scroll Down Indicator -->
  <div class="apple-hero-scroll-cue" aria-hidden="true">
    <a href="#destaques" class="scroll-cue-link">
      <span>Role para explorar</span>
      <span class="scroll-cue-arrow">↓</span>
    </a>
  </div>
</section>
