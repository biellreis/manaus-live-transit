---
import { installUrl } from '../config';
import HeroTransitMap from './HeroTransitMap.astro';
---

<section class="hero-99-stage" id="inicio" aria-label="Abertura Manô Transit">
  <div class="hero-99-banner">
    <!-- LADO ESQUERDO: APENAS O MAPA ANIMADO 100% VISÍVEL (SEM PESSOA, SEM OPACIDADE, SEM DEGRADÊ) -->
    <div class="hero-99-subject-side">
      <!-- MAPA VETORIAL ANIMADO EM TEMPO REAL ESPECÍFICO DO LADO ESQUERDO -->
      <div class="hero-99-transit-map-wrap">
        <HeroTransitMap />
      </div>
    </div>

    <!-- LADO DIREITO: BLOCO GIGANTE DA 99 NA COR BRANCA COM BORDAS CURVADAS PERFEITAMENTE ALINHADAS -->
    <div class="hero-99-shape-block">
      <div class="hero-99-shape-inner">
        <h1 class="hero-99-title">
          BAIXE AGORA O MAN<span class="hero-blue-letter">Ô</span>
        </h1>

        <p class="hero-99-subtitle">
          Monitore ônibus, linhas e paradas de Manaus em tempo real.
        </p>

        <!-- BOTÕES ESTILO 99 BEM GRANDES COM ÍCONES RIGOROSAMENTE CENTRALIZADOS -->
        <div class="hero-99-btn-group">
          <a href={installUrl('ios')} class="hero-btn-large hero-btn-apple hero-btn-99" data-install="ios" aria-label="Instalar no iPhone">
            <span class="btn-icon-capsule btn-icon-capsule-apple">
              <svg class="btn-icon btn-icon-apple" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.67-.82 1.13-1.96.99-3.12-1 .04-2.17.67-2.85 1.48-.6.69-1.12 1.84-.98 2.97 1.11.09 2.19-.53 2.84-1.33z"/>
              </svg>
            </span>
            <div class="btn-text-block">
              <span class="btn-subtext">Disponível para iOS</span>
              <span class="btn-maintext">Instalar no iPhone</span>
            </div>
          </a>

          <a href="/downloads/Mano.apk" download="Mano.apk" class="hero-btn-large hero-btn-android hero-btn-99 install-android" data-install="android" aria-label="Baixar aplicativo Manô no Android">
            <span class="btn-icon-capsule btn-icon-capsule-android">
              <svg class="btn-icon btn-icon-android" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.996-3.4572c.1126-.195.0456-.4445-.1494-.5571-.195-.1126-.4445-.0456-.5571.1494l-2.022 3.5022C15.602 8.358 13.856 8 12 8s-3.602.358-5.149 1.0587L4.829 5.5566c-.1126-.195-.3621-.262-.5571-.1494-.195.1126-.262.3621-.1494.5571l1.996 3.4572C2.688 11.1867.343 14.659.343 18.6586h23.314c0-3.9996-2.345-7.4719-5.7765-9.3372"/>
              </svg>
            </span>
            <div class="btn-text-block">
              <span class="btn-subtext">Disponível para Android</span>
              <span class="btn-maintext">Baixar Mano.apk</span>
            </div>
          </a>
        </div>

        <!-- NOTA DE RODAPÉ ESTILO 99 (IDÊNTICO À REFERÊNCIA) -->
        <p class="hero-99-footnote">
          *Pesa menos de 3MB • Sem cadastro • Zero anúncios • 100% Gratuito
        </p>
      </div>
    </div>
  </div>
</section>
