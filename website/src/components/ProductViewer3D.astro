---
---

<section class="apple-closer-look-section" id="sistema" aria-labelledby="closer-look-heading">
  <div class="apple-container closer-look-container">
    <!-- Header: Short title and subtitle -->
    <div class="closer-look-header">
      <h2 id="closer-look-heading" class="apple-section-headline">
        O Sistema
      </h2>
      <p class="apple-section-subhead">
        A interface real do aplicativo em 4 módulos.
      </p>
    </div>

    <!-- Official 4-Tab Navigation (Matching BottomNav.tsx from client/src) -->
    <div class="app-nav-tabs-bar" role="tablist" aria-label="Navegação do aplicativo Manô">
      <button
        class="app-nav-tab-btn active"
        role="tab"
        aria-selected="true"
        data-app-tab="home"
        id="tabBtn-home"
      >
        <svg class="tab-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Início</span>
      </button>

      <button
        class="app-nav-tab-btn"
        role="tab"
        aria-selected="false"
        data-app-tab="lines"
        id="tabBtn-lines"
      >
        <svg class="tab-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M8 6v6"/>
          <path d="M15 6v6"/>
          <path d="M2 12h19.6"/>
          <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4C2.9 6 1.9 6.8 1.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3"/>
          <circle cx="7" cy="18" r="2"/>
          <path d="M9 18h5"/>
          <circle cx="16" cy="18" r="2"/>
        </svg>
        <span>Linhas</span>
      </button>

      <button
        class="app-nav-tab-btn"
        role="tab"
        aria-selected="false"
        data-app-tab="stops"
        id="tabBtn-stops"
      >
        <svg class="tab-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>Terminais</span>
      </button>

      <button
        class="app-nav-tab-btn"
        role="tab"
        aria-selected="false"
        data-app-tab="alerts"
        id="tabBtn-alerts"
      >
        <svg class="tab-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
        </svg>
        <span>Alertas</span>
      </button>
    </div>

    <!-- Live Screen View Container (Real App UI Screens) -->
    <div class="app-screens-stage">
      <!-- 1. TELA INÍCIO (HomeTab.tsx) -->
      <div class="app-screen-view active" id="appScreen-home">
        <div class="home-screen-shell">
          <!-- Greeting Header -->
          <div class="home-screen-header">
            <h3 class="home-greeting">Olá, Passageiro!</h3>
            <span class="home-badge-live">Manaus em Tempo Real</span>
          </div>

          <!-- Search Trigger Pill (Uber/99 style from HomeTab.tsx) -->
          <div class="home-search-pill">
            <div class="search-pill-content">
              <svg class="search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
              <span class="search-placeholder">Para onde vamos hoje?</span>
            </div>
            <span class="search-pill-cta">Buscar</span>
          </div>

          <!-- Para Você: 4 Circular Shortcut Actions (HomeTab.tsx) -->
          <div class="home-shortcuts-bar">
            <div class="shortcut-item">
              <div class="shortcut-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" aria-hidden="true">
                  <path d="M8 6v6"/>
                  <path d="M15 6v6"/>
                  <path d="M2 12h19.6"/>
                  <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4C2.9 6 1.9 6.8 1.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3"/>
                  <circle cx="7" cy="18" r="2"/>
                  <path d="M9 18h5"/>
                  <circle cx="16" cy="18" r="2"/>
                </svg>
              </div>
              <span class="shortcut-label">Ônibus Direto</span>
            </div>

            <div class="shortcut-item">
              <div class="shortcut-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" aria-hidden="true">
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <span class="shortcut-label">Terminais</span>
            </div>

            <div class="shortcut-item">
              <div class="shortcut-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
              </div>
              <span class="shortcut-label">Bairros</span>
            </div>

            <div class="shortcut-item">
              <div class="shortcut-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <span class="shortcut-label">Trânsito</span>
            </div>
          </div>

          <!-- Mini Map & Live Vehicle Stage (HomeMiniMap.tsx) -->
          <div class="home-map-showcase">
            <div class="mini-map-transit-layer" aria-hidden="true">
              <svg class="mini-map-svg" viewBox="0 0 900 320" preserveAspectRatio="none">
                <path d="M 60,260 Q 240,240 450,160 T 840,70" stroke="#27272A" stroke-width="6" fill="none" />
                <path d="M 120,40 Q 300,120 450,160 T 780,280" stroke="#3B82F6" stroke-width="4" fill="none" />
                <path d="M 80,180 Q 280,170 540,200 T 820,150" stroke="#F97316" stroke-width="3" fill="none" stroke-dasharray="8 6" />

                <!-- Transit Hubs -->
                <circle cx="120" cy="40" r="7" fill="#F97316" />
                <circle cx="450" cy="160" r="8" fill="#3B82F6" />
                <circle cx="780" cy="280" r="7" fill="#F97316" />
              </svg>

              <!-- Live Bus Markers on Map -->
              <div class="mini-bus-marker bus-640" style="left: 45%; top: 46%;">
                <span class="mini-bus-tag blue">640</span>
              </div>
              <div class="mini-bus-marker bus-300" style="left: 72%; top: 22%;">
                <span class="mini-bus-tag orange">300</span>
              </div>
            </div>

            <!-- Floating Telemetry Snapshot Card (BusTelemetryCard.tsx) -->
            <div class="floating-telemetry-pill">
              <div class="telemetry-pill-head">
                <div class="telemetry-pill-bus">
                  <span class="pill-bus-code">640</span>
                  <div class="pill-bus-info">
                    <strong>Veículo #640-12</strong>
                    <span>Expresso T4 / Centro</span>
                  </div>
                </div>
                <span class="pill-status-ok">Conectado</span>
              </div>
              <div class="telemetry-pill-progress">
                <div class="pill-progress-bar" style="width: 74%;"></div>
              </div>
              <div class="telemetry-pill-meta">
                <span>Velocidade: <strong>44 km/h</strong></span>
                <span>Próxima: <strong>Estação E2 Arena (3 min)</strong></span>
              </div>
            </div>
          </div>

          <!-- Quick Destination Chips -->
          <div class="home-destinations-row">
            <span class="dest-chip">Terminal 1 — Constantino Nery</span>
            <span class="dest-chip">Arena da Amazônia</span>
            <span class="dest-chip">Terminal 4 — Jorge Teixeira</span>
            <span class="dest-chip">Estação Santos Dumont</span>
          </div>
        </div>
      </div>

      <!-- 2. TELA LINHAS (LinesTab.tsx) -->
      <div class="app-screen-view" id="appScreen-lines">
        <div class="lines-screen-shell">
          <div class="lines-screen-header">
            <div>
              <h3 class="lines-title">Linhas de Ônibus</h3>
              <p class="lines-sub">240+ linhas com telemetria ativa em Manaus</p>
            </div>
            <span class="lines-count-pill">Frota Monitorada</span>
          </div>

          <!-- Search Input (LinesTab.tsx) -->
          <div class="lines-search-container">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lines-search-icon" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <span class="lines-search-mock">Buscar por número ou destino (ex: 640, Centro, T4)...</span>
          </div>

          <!-- Category Filter Chips -->
          <div class="lines-filter-chips" role="tablist" aria-label="Filtro de linhas">
            <button type="button" class="filter-pill active" data-line-filter="all">Todas as Linhas</button>
            <button type="button" class="filter-pill" data-line-filter="direto">Ônibus Direto</button>
            <button type="button" class="filter-pill" data-line-filter="bairro">Linhas de Bairro</button>
            <button type="button" class="filter-pill" data-line-filter="circular">Circulares</button>
          </div>

          <!-- Lines Cards Grid -->
          <div class="lines-cards-grid">
            <div class="app-line-card">
              <div class="line-card-code blue">640</div>
              <div class="line-card-info">
                <h4>Expresso T4 / T3 / Centro</h4>
                <p>Via Constantino Nery e Djalma Batista</p>
              </div>
              <div class="line-card-eta">
                <span class="eta-pill blue">4 min</span>
                <span class="eta-label">No Horário</span>
              </div>
            </div>

            <div class="app-line-card">
              <div class="line-card-code blue">300</div>
              <div class="line-card-info">
                <h4>Expresso T3 / Centro</h4>
                <p>Via Av. Torquato Tapajós</p>
              </div>
              <div class="line-card-eta">
                <span class="eta-pill blue">7 min</span>
                <span class="eta-label">No Horário</span>
              </div>
            </div>

            <div class="app-line-card">
              <div class="line-card-code orange">448</div>
              <div class="line-card-info">
                <h4>Cidade de Deus / T1 / Centro</h4>
                <p>Via Max Teixeira e BRS</p>
              </div>
              <div class="line-card-eta">
                <span class="eta-pill orange">12 min</span>
                <span class="eta-label">Fluxo Normal</span>
              </div>
            </div>

            <div class="app-line-card">
              <div class="line-card-code orange">560</div>
              <div class="line-card-info">
                <h4>T4 / Cidade de Deus / Centro</h4>
                <p>Via Autaz Mirim e Corredor Norte</p>
              </div>
              <div class="line-card-eta">
                <span class="eta-pill orange">15 min</span>
                <span class="eta-label">Fluxo Normal</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. TELA TERMINAIS (StopsTab.tsx) -->
      <div class="app-screen-view" id="appScreen-stops">
        <div class="stops-screen-shell">
          <div class="stops-screen-header">
            <div>
              <h3 class="stops-title">Terminais e Plataformas</h3>
              <p class="stops-sub">Integração sem catraca e conexões municipais</p>
            </div>
            <span class="stops-tag-hub">5 Terminais (T1 a T5)</span>
          </div>

          <!-- Segment Tabs Switcher -->
          <div class="stops-segment-switcher">
            <span class="segment-btn active">Terminais (T1 ao T5)</span>
            <span class="segment-btn">Estações (E1 a E4)</span>
          </div>

          <!-- Terminais Cards Grid -->
          <div class="terminals-cards-grid">
            <div class="app-terminal-card">
              <div class="terminal-badge-squircle orange">T1</div>
              <div class="terminal-card-body">
                <h4>Terminal 1 — Constantino Nery</h4>
                <p>Centro • Conexão dos corredores Norte e Sul</p>
                <div class="terminal-lines-row">
                  <span class="line-mini-badge blue">640</span>
                  <span class="line-mini-badge blue">300</span>
                  <span class="line-mini-badge orange">448</span>
                  <span class="line-mini-badge orange">560</span>
                  <span class="line-mini-badge blue">120</span>
                </div>
              </div>
              <span class="terminal-free-pill">Integração R$ 0,00</span>
            </div>

            <div class="app-terminal-card">
              <div class="terminal-badge-squircle orange">T2</div>
              <div class="terminal-card-body">
                <h4>Terminal 2 — Cachoeirinha</h4>
                <p>Zona Sul • Conexão Polo Industrial e Centro</p>
                <div class="terminal-lines-row">
                  <span class="line-mini-badge blue">650</span>
                  <span class="line-mini-badge blue">651</span>
                  <span class="line-mini-badge orange">542</span>
                  <span class="line-mini-badge orange">418</span>
                </div>
              </div>
              <span class="terminal-free-pill">Integração R$ 0,00</span>
            </div>

            <div class="app-terminal-card">
              <div class="terminal-badge-squircle orange">T3</div>
              <div class="terminal-card-body">
                <h4>Terminal 3 — Cidade Nova</h4>
                <p>Zona Norte • Conexão com bairros e Max Teixeira</p>
                <div class="terminal-lines-row">
                  <span class="line-mini-badge blue">640</span>
                  <span class="line-mini-badge blue">350</span>
                  <span class="line-mini-badge orange">450</span>
                  <span class="line-mini-badge blue">300</span>
                </div>
              </div>
              <span class="terminal-free-pill">Integração R$ 0,00</span>
            </div>

            <div class="app-terminal-card">
              <div class="terminal-badge-squircle orange">T4</div>
              <div class="terminal-card-body">
                <h4>Terminal 4 — Jorge Teixeira</h4>
                <p>Zona Leste • Ponto de partida do Expresso 640</p>
                <div class="terminal-lines-row">
                  <span class="line-mini-badge blue">640</span>
                  <span class="line-mini-badge orange">560</span>
                  <span class="line-mini-badge blue">652</span>
                  <span class="line-mini-badge orange">678</span>
                </div>
              </div>
              <span class="terminal-free-pill">Integração R$ 0,00</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. TELA ALERTAS (AlertsTab.tsx) -->
      <div class="app-screen-view" id="appScreen-alerts">
        <div class="alerts-screen-shell">
          <div class="alerts-screen-header">
            <div>
              <h3 class="alerts-title">Central de Ocorrências</h3>
              <p class="alerts-sub">Notificações operacionais e tráfego em tempo real</p>
            </div>
            <span class="alerts-live-status">SSE Conectado</span>
          </div>

          <!-- Alert Filters -->
          <div class="alerts-filter-chips" role="tablist" aria-label="Filtro de alertas">
            <button type="button" class="filter-pill active" data-alert-filter="all">Todos</button>
            <button type="button" class="filter-pill" data-alert-filter="acidentes">Acidentes</button>
            <button type="button" class="filter-pill" data-alert-filter="lentidao">Lentidão</button>
            <button type="button" class="filter-pill" data-alert-filter="fiscalizacao">Fiscalização</button>
          </div>

          <!-- Alert Cards Grid -->
          <div class="alerts-feed-grid">
            <div class="app-alert-card border-orange">
              <div class="alert-card-top">
                <span class="alert-badge orange">LENTIDÃO</span>
                <span class="alert-time">Há 8 min</span>
              </div>
              <h4 class="alert-headline">Tráfego lento no sentido Centro após chuva na região</h4>
              <p class="alert-text">Acúmulo parcial de água na pista lateral próximo ao Amazonas Shopping. Faixa exclusiva BRS operando normalmente.</p>
              <div class="alert-lines-row">
                <span class="alert-line-pill blue">640</span>
                <span class="alert-line-pill blue">300</span>
                <span class="alert-line-pill orange">448</span>
              </div>
            </div>

            <div class="app-alert-card border-blue">
              <div class="alert-card-top">
                <span class="alert-badge blue">OPERAÇÃO REGULAR</span>
                <span class="alert-time">Há 24 min</span>
              </div>
              <h4 class="alert-headline">Intervalos regulares e telemetria GPS 100% ativa</h4>
              <p class="alert-text">Todas as plataformas de transferência nas estações São Jorge, Arena da Amazônia, Santos Dumont e Flores em operação plena.</p>
              <div class="alert-lines-row">
                <span class="alert-line-pill blue">640</span>
                <span class="alert-line-pill blue">120</span>
                <span class="alert-line-pill orange">560</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
