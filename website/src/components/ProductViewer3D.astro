---
---

<section class="apple-closer-look-section" id="sistema" aria-labelledby="closer-look-heading">
  <div class="closer-look-container">
    <!-- Apple Header -->
    <div class="closer-look-header">
      <p class="apple-eyebrow-accent">SISTEMA & INTERFACE</p>
      <h2 id="closer-look-heading" class="apple-section-headline">
        O Manô por dentro.
      </h2>
      <p class="apple-section-subhead">
        Construído para máxima velocidade, clareza e controle na palma da mão. Explore cada camada do sistema oficial de transporte de Manaus.
      </p>
    </div>

    <!-- Minimalist Clean Horizontal Tab Menu -->
    <div class="system-nav-tabs" role="tablist" aria-label="Módulos do sistema Manô">
      <button
        class="system-tab-btn active"
        role="tab"
        aria-selected="true"
        data-sys-tab="ida"
      >
        <span class="tab-indicator-dot">•</span>
        <span>Linhas Expressas (640)</span>
      </button>

      <button
        class="system-tab-btn"
        role="tab"
        aria-selected="false"
        data-sys-tab="planner"
      >
        <span>Planejador de Viagens</span>
      </button>

      <button
        class="system-tab-btn"
        role="tab"
        aria-selected="false"
        data-sys-tab="journey"
      >
        <span>Trajetos & Paradas</span>
      </button>

      <button
        class="system-tab-btn"
        role="tab"
        aria-selected="false"
        data-sys-tab="terminals"
      >
        <span>Terminais Urbanos</span>
      </button>

      <button
        class="system-tab-btn"
        role="tab"
        aria-selected="false"
        data-sys-tab="alerts"
      >
        <span>Alertas da Cidade</span>
      </button>
    </div>

    <!-- Full-Extension System Display Stage (Zero Phone Mockup, 100% Real App System) -->
    <div class="system-full-stage">
      <!-- 1. ABA LINHAS EXPRESSAS (640) -->
      <div class="system-screen-view active" id="sysView-ida">
        <div class="system-stage-header">
          <div class="stage-line-title">
            <span class="sys-chip blue">640</span>
            <div>
              <h3>Expresso T4 / T3 / Centro</h3>
              <p>Sentido Ida • Corredores Constantino Nery e Djalma Batista</p>
            </div>
          </div>
          <div class="stage-live-tag">
            <span class="pulse-dot"></span>
            <span>TELEMETRIA ATIVA (SSE 4.5s)</span>
          </div>
        </div>

        <div class="system-stage-grid">
          <!-- Left: Live Telemetry Instrument -->
          <div class="system-card telemetry-card">
            <span class="card-kicker">TELEMETRIA DO VEÍCULO</span>
            <div class="telemetry-big-stat">
              <span class="stat-number">44</span>
              <span class="stat-unit">km/h</span>
            </div>
            <div class="telemetry-meta-grid">
              <div class="meta-item">
                <span class="meta-label">PREFIXO / PLACA</span>
                <span class="meta-value">OAA-4819</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">INTERVALO</span>
                <span class="meta-value">6 min</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">PONTUALIDADE</span>
                <span class="meta-value status-good">No Horário</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">LOTAÇÃO</span>
                <span class="meta-value">Moderada</span>
              </div>
            </div>
            <div class="telemetry-next-box">
              <span class="next-label">PRÓXIMA PARADA</span>
              <strong class="next-station">Estação E2 — Arena da Amazônia</strong>
              <span class="next-eta">Chegando em 3 min • 450m</span>
            </div>
          </div>

          <!-- Right: Visual Vector Route Map Display -->
          <div class="system-card map-corridor-card">
            <span class="card-kicker">CORREDOR EM TEMPO REAL</span>
            <div class="corridor-map-visual">
              <svg viewBox="0 0 600 240" fill="none" class="corridor-svg" preserveAspectRatio="xMidYMid meet">
                <!-- Corridor line -->
                <path d="M 40 120 L 160 120 L 300 120 L 440 120 L 560 120" stroke="#3b82f6" stroke-width="6" stroke-linecap="round"/>
                <!-- Stations -->
                <g transform="translate(40, 120)">
                  <circle r="8" fill="#18181b" stroke="#ffffff" stroke-width="2.5"/>
                  <text y="28" fill="#94a3b8" font-size="11" text-anchor="middle" font-weight="600">T4 Jorge Teixeira</text>
                  <text y="42" fill="#64748b" font-size="10" text-anchor="middle">Partiu 14:15</text>
                </g>
                <g transform="translate(160, 120)">
                  <circle r="8" fill="#18181b" stroke="#ffffff" stroke-width="2.5"/>
                  <text y="28" fill="#94a3b8" font-size="11" text-anchor="middle" font-weight="600">E4 Flores</text>
                  <text y="42" fill="#64748b" font-size="10" text-anchor="middle">Passou</text>
                </g>
                <g transform="translate(300, 120)">
                  <circle r="8" fill="#18181b" stroke="#ffffff" stroke-width="2.5"/>
                  <text y="28" fill="#94a3b8" font-size="11" text-anchor="middle" font-weight="600">E3 Santos Dumont</text>
                  <text y="42" fill="#64748b" font-size="10" text-anchor="middle">Passou</text>
                </g>
                <!-- Approaching Station with Bus -->
                <g transform="translate(400, 120)">
                  <!-- Bus Marker -->
                  <circle r="18" fill="#3b82f6" fill-opacity="0.25" class="bus-pulse"/>
                  <circle r="12" fill="#3b82f6" stroke="#ffffff" stroke-width="2"/>
                  <path d="M -4 3 L 4 3 L 4 -3 C 4 -4 -4 -4 -4 -3 Z" stroke="#ffffff" stroke-width="1.2" fill="none"/>
                  <rect x="-18" y="-32" width="36" height="18" rx="5" fill="#3b82f6"/>
                  <text x="0" y="-20" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">640</text>
                </g>
                <g transform="translate(440, 120)">
                  <circle r="11" fill="#3b82f6" stroke="#ffffff" stroke-width="3"/>
                  <text y="28" fill="#3b82f6" font-size="12" text-anchor="middle" font-weight="800">E2 Arena</text>
                  <text y="44" fill="#3b82f6" font-size="10" text-anchor="middle" font-weight="700">Chegando (3 min)</text>
                </g>
                <g transform="translate(560, 120)">
                  <circle r="8" fill="#18181b" stroke="#ffffff" stroke-width="2.5"/>
                  <text y="28" fill="#94a3b8" font-size="11" text-anchor="middle" font-weight="600">T1 Centro</text>
                  <text y="42" fill="#64748b" font-size="10" text-anchor="middle">Destino Final</text>
                </g>
              </svg>
            </div>
            <div class="corridor-notes">
              <span>Faixa exclusiva BRS na Constantino Nery • Monitoramento contínuo da frota</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. ABA PLANEJADOR DE VIAGENS -->
      <div class="system-screen-view" id="sysView-planner">
        <div class="system-stage-header">
          <div>
            <h3>Planejador Inteligente Ponto a Ponto</h3>
            <p>Menor caminhada a pé e conexões com tempo de espera mínimo</p>
          </div>
          <span class="stage-badge-pill">ALGORITMO DE ROTEIRIZAÇÃO</span>
        </div>

        <div class="system-stage-grid">
          <!-- Inputs & Options -->
          <div class="system-card">
            <span class="card-kicker">LOCALIZAÇÃO & DESTINO</span>
            <div class="planner-form-mock">
              <div class="planner-field">
                <span class="dot green-dot"></span>
                <div class="field-texts">
                  <span class="label">Origem</span>
                  <strong>Rua Kobe — Parque 10 de Novembro</strong>
                </div>
              </div>
              <div class="field-connector"></div>
              <div class="planner-field">
                <span class="dot orange-dot"></span>
                <div class="field-texts">
                  <span class="label">Destino</span>
                  <strong>Terminal 1 (T1) — Constantino Nery • Centro</strong>
                </div>
              </div>
            </div>
            <div class="planner-criteria-row">
              <span class="crit-pill active">⚡ Rota mais rápida (18 min)</span>
              <span class="crit-pill">🚶 Menor caminhada (240m)</span>
              <span class="crit-pill">🔄 Sem baldeação</span>
            </div>
          </div>

          <!-- Step Progression Result -->
          <div class="system-card">
            <span class="card-kicker">ITINERÁRIO DETALHADO</span>
            <div class="itinerary-steps-list">
              <div class="step-card-row">
                <div class="step-bullet walk-bullet">🚶</div>
                <div class="step-details">
                  <strong>Caminhada até a Estação E2 — Arena da Amazônia</strong>
                  <span>3 min • 240 metros pela Av. Pedro Teixeira</span>
                </div>
              </div>
              <div class="step-card-row active-board">
                <div class="step-bullet bus-bullet">🚌</div>
                <div class="step-details">
                  <div class="step-line-chip-row">
                    <span class="sys-chip blue">640</span>
                    <strong>Embarque na Estação E2 (Plataforma B)</strong>
                    <span class="time-tag">3 min</span>
                  </div>
                  <span>Expresso T4 / T3 / Centro • 6 paradas até o T1</span>
                </div>
              </div>
              <div class="step-card-row">
                <div class="step-bullet dest-bullet">🏁</div>
                <div class="step-details">
                  <strong>Desembarque no Terminal 1 (T1)</strong>
                  <span>Conexão livre para qualquer linha da Zona Sul ou Centro</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. ABA TRAJETOS & PARADAS -->
      <div class="system-screen-view" id="sysView-journey">
        <div class="system-stage-header">
          <div>
            <h3>Trajetos & Paradas Georreferenciadas</h3>
            <p>Mais de 240 linhas catalogadas com paradas de ida e volta mapeadas</p>
          </div>
          <span class="stage-badge-pill">MALHA COMPLETA</span>
        </div>

        <div class="system-stage-grid">
          <div class="system-card full-width-card">
            <div class="corridor-timeline-panoramic">
              <div class="timeline-station-box">
                <span class="station-code">T4</span>
                <strong>Terminal 4</strong>
                <span class="station-sub">Jorge Teixeira</span>
              </div>
              <span class="timeline-arrow">→</span>
              <div class="timeline-station-box">
                <span class="station-code">E4</span>
                <strong>Estação E4</strong>
                <span class="station-sub">Flores</span>
              </div>
              <span class="timeline-arrow">→</span>
              <div class="timeline-station-box">
                <span class="station-code">E3</span>
                <strong>Estação E3</strong>
                <span class="station-sub">Santos Dumont</span>
              </div>
              <span class="timeline-arrow">→</span>
              <div class="timeline-station-box active-station">
                <span class="station-code">E2</span>
                <strong>Estação E2</strong>
                <span class="station-sub">Arena da Amazônia</span>
                <span class="bus-now-badge">Ônibus 640 Aqui</span>
              </div>
              <span class="timeline-arrow">→</span>
              <div class="timeline-station-box">
                <span class="station-code">E1</span>
                <strong>Estação E1</strong>
                <span class="station-sub">São Jorge</span>
              </div>
              <span class="timeline-arrow">→</span>
              <div class="timeline-station-box">
                <span class="station-code">T1</span>
                <strong>Terminal 1</strong>
                <span class="station-sub">Constantino Nery</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. ABA TERMINAIS URBANOS -->
      <div class="system-screen-view" id="sysView-terminals">
        <div class="system-stage-header">
          <div>
            <h3>Rede de Terminais de Integração (T1 a T5)</h3>
            <p>Grandes nós de transbordo e conexão de passageiros de Manaus</p>
          </div>
          <span class="stage-badge-pill">INTEGRAÇÃO R$ 0,00</span>
        </div>

        <div class="terminals-five-grid">
          <div class="terminal-mini-card">
            <div class="t-badge amber">T1</div>
            <strong>Constantino Nery</strong>
            <span>Centro Histórico</span>
            <div class="t-lines">640, 300, 448, 560, 120</div>
          </div>
          <div class="terminal-mini-card">
            <div class="t-badge amber">T2</div>
            <strong>Cachoeirinha</strong>
            <span>Zona Sul & Polo Industrial</span>
            <div class="t-lines">650, 651, 542, 418, 715</div>
          </div>
          <div class="terminal-mini-card">
            <div class="t-badge amber">T3</div>
            <strong>Cidade Nova</strong>
            <span>Zona Norte</span>
            <div class="t-lines">640, 350, 450, 300, A030</div>
          </div>
          <div class="terminal-mini-card">
            <div class="t-badge amber">T4</div>
            <strong>Jorge Teixeira</strong>
            <span>Zona Leste</span>
            <div class="t-lines">640, 560, 652, 678, 062</div>
          </div>
          <div class="terminal-mini-card">
            <div class="t-badge amber">T5</div>
            <strong>São José</strong>
            <span>Alameda Cosme Ferreira</span>
            <div class="t-lines">652, 600, 671, 008, 014</div>
          </div>
        </div>
      </div>

      <!-- 5. ABA ALERTAS DA CIDADE -->
      <div class="system-screen-view" id="sysView-alerts">
        <div class="system-stage-header">
          <div>
            <h3>Alertas de Trânsito & Defesa Civil</h3>
            <p>Ocorrências em tempo real, interdições e comunicados meteorológicos</p>
          </div>
          <span class="stage-badge-pill">ATUALIZAÇÃO EM TEMPO REAL</span>
        </div>

        <div class="system-stage-grid">
          <div class="system-card alert-row-card">
            <div class="alert-icon-box orange">⚠</div>
            <div class="alert-info-box">
              <div class="alert-top">
                <span class="alert-type orange">LENTIDÃO POR CHUVA</span>
                <span class="alert-time">Há 8 min</span>
              </div>
              <h4>Av. Djalma Batista — Próximo ao Amazonas Shopping</h4>
              <p>Tráfego com retenção no sentido Centro devido ao acúmulo temporário de água na pista lateral. Corredor exclusivo de ônibus operando normalmente.</p>
            </div>
          </div>

          <div class="system-card alert-row-card">
            <div class="alert-icon-box blue">ℹ</div>
            <div class="alert-info-box">
              <div class="alert-top">
                <span class="alert-type blue">INFORMAÇÃO OPERACIONAL</span>
                <span class="alert-time">Há 22 min</span>
              </div>
              <h4>Corredor da Constantino Nery — Estações E1 a E4</h4>
              <p>Operação das estações de transferência fluindo com intervalos regulares de 4 a 6 minutos nas linhas troncais expressas.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
