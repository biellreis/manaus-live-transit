---
const { screen='home', class:className='', android=false, eager=false, id, label='' }=Astro.props;
---
<div class:list={['phone', className, {'android': android}]} aria-hidden="true">
  <div class="phone-rim"></div>
  <div class="phone-glass-glare"></div>
  <div class="phone-edge"></div>
  <div class="phone-display">
    {!android && (
      <div class="dynamic-island">
        <span class="island-camera"></span>
        <span class="island-sensor"></span>
      </div>
    )}
    {android && <div class="android-bar"><span>09:41</span><i></i><span>◔ ▰</span></div>}
    <img id={id} src={`/screens/${screen}.webp`} width="768" height={android?1552:1670} alt={label || ""} loading={eager?'eager':'lazy'} decoding="async"/>
  </div>
  <div class="phone-button side-power"></div>
  <div class="phone-button side-vol-up"></div>
  <div class="phone-button side-vol-down"></div>
</div>
