---
---

<section class="apple-planner-section" id="planejador" aria-labelledby="planner-heading">
  <div class="apple-container">
    <div class="apple-section-header">
      <h2 id="planner-heading" class="apple-section-headline">
        Planejador
      </h2>
      <p class="apple-section-subhead">
        Trajetos calculados ponto a ponto.
      </p>
    </div>

    <!-- Apple Interactive Planner: Full Extension Widescreen Dashboard -->
    <div class="planner-widescreen-dashboard">
      <!-- Left Panel: Search Inputs & Itinerary Options (TripPlannerModal.tsx) -->
      <div class="planner-panel-controls">
        <!-- Search & Origin/Destination Bar -->
        <div class="planner-card-header-bar">
          <div class="planner-inputs-container">
            <div class="planner-input-row">
              <span class="planner-pin origin-pin"></span>
              <div class="planner-field-info">
                <span class="planner-field-label">ORIGEM</span>
                <span class="planner-field-value">Rua Kobe — Parque 10 de Novembro</span>
              </div>
            </div>
            <div class="planner-inputs-divider">
              <span class="divider-line"></span>
              <button type="button" class="planner-swap-btn" aria-label="Inverter origem e destino">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="20" x2="7" y2="4"></line>
                  <polyline points="3 8 7 4 11 8"></polyline>
                  <line x1="17" y1="4" x2="17" y2="20"></line>
                  <polyline points="21 16 17 20 13 16"></polyline>
                </svg>
              </button>
            </div>
            <div class="planner-input-row">
              <span class="planner-pin dest-pin"></span>
              <div class="planner-field-info">
                <span class="planner-field-label">DESTINO</span>
                <span class="planner-field-value">Terminal 1 (T1) — Constantino Nery • Centro</span>
              </div>
            </div>
          </div>

          <!-- Transit Route Options (From TripPlannerModal.tsx) -->
          <div class="planner-options-list">
            <!-- Option 1: Selected / Fastest -->
            <div class="planner-option-card active">
              <div class="option-bus-icon blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" aria-hidden="true">
                  <path d="M8 6v6"/>
                  <path d="M15 6v6"/>
                  <path d="M2 12h19.6"/>
                  <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4C2.9 6 1.9 6.8 1.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3"/>
                  <circle cx="7" cy="18" r="2"/>
                  <path d="M9 18h5"/>
                  <circle cx="16" cy="18" r="2"/>
                </svg>
              </div>
              <div class="option-details">
                <div class="option-title-row">
                  <strong class="option-line-title">Linha 640 Expresso</strong>
                  <span class="option-time-pill">18 min</span>
                </div>
                <span class="option-subtitle">Via Corredor Constantino Nery (BRS Exclusivo)</span>
                <div class="option-badges-row">
                  <span class="option-badge-fast">Mais rápida</span>
                  <span class="option-eta-tag">Chega às 14:52</span>
                  <span class="option-fare-tag">R$ 4,50</span>
                </div>
              </div>
            </div>

            <!-- Option 2: Alternative -->
            <div class="planner-option-card">
              <div class="option-bus-icon orange">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" aria-hidden="true">
                  <path d="M8 6v6"/>
                  <path d="M15 6v6"/>
                  <path d="M2 12h19.6"/>
                  <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4C2.9 6 1.9 6.8 1.6 7.8l-1.4 5c-.1.4-.2.8-.2 1.2 0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3"/>
                  <circle cx="7" cy="18" r="2"/>
                  <path d="M9 18h5"/>
                  <circle cx="16" cy="18" r="2"/>
                </svg>
              </div>
              <div class="option-details">
                <div class="option-title-row">
                  <strong class="option-line-title">Linha 350 Semi-Expresso</strong>
                  <span class="option-time-pill">24 min</span>
                </div>
                <span class="option-subtitle">Via Av. Torquato Tapajós</span>
                <div class="option-badges-row">
                  <span class="option-badge-direct">Linha direta</span>
                  <span class="option-eta-tag">Chega às 14:58</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Main Step-by-Step Itinerary Steps -->
        <div class="planner-itinerary-body">
          <div class="itinerary-timeline">
            <!-- Step 1: Walking -->
            <div class="itinerary-step">
              <div class="timeline-gutter">
                <span class="timeline-dot dot-walk"></span>
                <span class="timeline-line walk-line"></span>
              </div>
              <div class="timeline-content">
                <div class="step-meta">
                  <span class="step-badge badge-walk">CAMINHADA</span>
                  <span class="step-duration">3 min • 240 metros</span>
                </div>
                <h4 class="step-headline">Caminhe até a Estação E2 — Arena da Amazônia</h4>
              </div>
            </div>

            <!-- Step 2: Board Bus -->
            <div class="itinerary-step step-highlighted">
              <div class="timeline-gutter">
                <span class="timeline-dot dot-bus-board"></span>
                <span class="timeline-line bus-line"></span>
              </div>
              <div class="timeline-content">
                <div class="step-meta">
                  <span class="bus-number-badge">640</span>
                  <span class="bus-name-badge">Expresso T4 / T3 / Centro</span>
                  <span class="live-pill">
                    <span class="pulse-dot"></span>
                    Chegando em 3 min
                  </span>
                </div>
                <h4 class="step-headline">Embarque na Plataforma B (Sentido Centro)</h4>
              </div>
            </div>

            <!-- Step 3: Arrive at T1 -->
            <div class="itinerary-step step-arrival">
              <div class="timeline-gutter">
                <span class="timeline-dot dot-dest"></span>
              </div>
              <div class="timeline-content">
                <div class="step-meta">
                  <span class="step-badge badge-dest">DESEMBARQUE</span>
                  <span class="step-duration">Chegada às 14:52</span>
                </div>
                <h4 class="step-headline">Terminal 1 (T1) — Constantino Nery • Centro</h4>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Panel: High-Fidelity Journey Vector Map Display (JourneyMap.tsx) -->
      <div class="planner-panel-map" aria-label="Mapa do itinerário planejado">
        <div class="planner-map-card">
          <div class="planner-map-bar">
            <span class="map-badge-live"><span class="pulse-dot"></span> TRAJETO AO VIVO</span>
            <span class="map-distance-note">Distância Total: 4.8 km</span>
          </div>

          <div class="planner-map-canvas-wrap">
            <svg viewBox="0 0 540 420" fill="none" class="journey-map-svg" preserveAspectRatio="xMidYMid meet">
              <defs>
                <linearGradient id="journeyGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3B82F6"/>
                  <stop offset="100%" stop-color="#2563EB"/>
                </linearGradient>
              </defs>

              <!-- Map grid background roads of Manaus -->
              <path d="M 40 60 L 500 60" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="2"/>
              <path d="M 40 180 L 500 180" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="2"/>
              <path d="M 40 300 L 500 300" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="2"/>
              <path d="M 140 30 L 140 390" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="2"/>
              <path d="M 380 30 L 380 390" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="2"/>

              <!-- Walking Path (Dotted White) -->
              <path d="M 120 70 L 160 110 L 220 130" stroke="#FFFFFF" stroke-width="3" stroke-dasharray="5 5" stroke-linecap="round"/>

              <!-- Transit Route Corridor (Constantino Nery Line) -->
              <path d="M 220 130 L 260 210 L 310 290 L 360 360" stroke="url(#journeyGradient)" stroke-width="6" stroke-linecap="round"/>

              <!-- Origin Marker: Parque 10 -->
              <g transform="translate(120, 70)">
                <circle r="9" fill="#3B82F6" stroke="#FFFFFF" stroke-width="2.5"/>
                <circle r="4" fill="#FFFFFF"/>
                <rect x="14" y="-12" width="130" height="24" rx="6" fill="#18181B" stroke="#27272A" stroke-width="1"/>
                <text x="22" y="4" fill="#FFFFFF" font-size="11" font-weight="700">Origem: Parque 10</text>
              </g>

              <!-- Walking Annotation -->
              <g transform="translate(170, 105)">
                <rect x="-8" y="-10" width="76" height="20" rx="5" fill="#27272A"/>
                <text x="30" y="4" fill="#FFFFFF" font-size="10" font-weight="600" text-anchor="middle">240m a pé</text>
              </g>

              <!-- Boarding Marker: Estação E2 Arena -->
              <g transform="translate(220, 130)">
                <circle r="8" fill="#3B82F6" stroke="#FFFFFF" stroke-width="2.5"/>
                <rect x="14" y="-12" width="160" height="24" rx="6" fill="#18181B" stroke="#3B82F6" stroke-width="1.2"/>
                <text x="22" y="4" fill="#3B82F6" font-size="11" font-weight="800">Embarque: Estação E2</text>
              </g>

              <!-- Bus in transit on the corridor -->
              <g transform="translate(260, 210)">
                <circle r="11" fill="#3B82F6" stroke="#FFFFFF" stroke-width="2"/>
                <rect x="16" y="-12" width="80" height="24" rx="6" fill="#3B82F6"/>
                <text x="56" y="4" fill="#FFFFFF" font-size="11" font-weight="800" text-anchor="middle">Ônibus 640</text>
              </g>

              <!-- Destination Marker: Terminal 1 -->
              <g transform="translate(360, 360)">
                <circle r="10" fill="#F97316" stroke="#FFFFFF" stroke-width="2.5"/>
                <circle r="4" fill="#FFFFFF"/>
                <rect x="-170" y="-12" width="156" height="24" rx="6" fill="#18181B" stroke="#27272A" stroke-width="1"/>
                <text x="-92" y="4" fill="#FFFFFF" font-size="11" font-weight="700" text-anchor="middle">Destino: Terminal 1 (T1)</text>
              </g>
            </svg>
          </div>

          <div class="planner-map-footer">
            <span class="route-stat-item">18 min totais</span>
            <span class="route-stat-item">3 min a pé</span>
            <span class="route-stat-item">15 min no ônibus</span>
            <span class="route-stat-item">Integração R$ 0,00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
