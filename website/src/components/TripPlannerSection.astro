---
---

<section class="apple-planner-section" id="planejador" aria-labelledby="planner-heading">
  <div class="apple-container">
    <div class="apple-section-header">
      <p class="apple-eyebrow-accent">ROTA PONTO A PONTO</p>
      <h2 id="planner-heading" class="apple-section-headline">
        Planeje qualquer trajeto.<br/>
        <span class="apple-headline-gradient">Menos passos, zero complicação.</span>
      </h2>
      <p class="apple-section-subhead">
        Digite sua origem e seu destino em Manaus. O Manô calcula a caminhada a pé exata, indica o ponto de embarque ideal e a melhor conexão entre linhas.
      </p>
    </div>

    <!-- Apple Interactive Planner: Large Detailed App Box (Zero Phone Mockup) -->
    <div class="planner-showcase-large-card">
      <!-- Search & Origin/Destination Bar -->
      <div class="planner-card-header-bar">
        <div class="planner-inputs-container">
          <div class="planner-input-row">
            <span class="planner-pin origin-pin"></span>
            <div class="planner-field-info">
              <span class="planner-field-label">ORIGEM</span>
              <span class="planner-field-value">Rua Kobe — Parque 10 de Novembro</span>
            </div>
          </div>
          <div class="planner-inputs-divider">
            <span class="divider-line"></span>
            <button class="planner-swap-btn" aria-label="Inverter origem e destino">⇅</button>
          </div>
          <div class="planner-input-row">
            <span class="planner-pin dest-pin"></span>
            <div class="planner-field-info">
              <span class="planner-field-label">DESTINO</span>
              <span class="planner-field-value">Terminal 1 (T1) — Constantino Nery • Centro</span>
            </div>
          </div>
        </div>

        <!-- Filter Pills -->
        <div class="planner-filter-pills">
          <span class="filter-pill active">⚡ Rota mais rápida (18 min)</span>
          <span class="filter-pill">🚶 Menor caminhada (240 m)</span>
          <span class="filter-pill">🔄 Linha direta sem baldeação</span>
        </div>
      </div>

      <!-- Main Step-by-Step Itinerary Body -->
      <div class="planner-itinerary-body">
        <div class="itinerary-timeline">
          <!-- Step 1: Walking -->
          <div class="itinerary-step">
            <div class="timeline-gutter">
              <span class="timeline-dot dot-walk"></span>
              <span class="timeline-line walk-line"></span>
            </div>
            <div class="timeline-content">
              <div class="step-meta">
                <span class="step-badge badge-walk">CAMINHADA</span>
                <span class="step-duration">3 min • 240 metros</span>
              </div>
              <h4 class="step-headline">Caminhe até a Estação E2 — Arena da Amazônia</h4>
              <p class="step-subtext">Siga pela calçada da Av. Pedro Teixeira em direção ao canteiro central da Constantino Nery.</p>
            </div>
          </div>

          <!-- Step 2: Board Bus -->
          <div class="itinerary-step step-highlighted">
            <div class="timeline-gutter">
              <span class="timeline-dot dot-bus-board"></span>
              <span class="timeline-line bus-line"></span>
            </div>
            <div class="timeline-content">
              <div class="step-meta">
                <span class="bus-number-badge">640</span>
                <span class="bus-name-badge">Expresso T4 / T3 / Centro</span>
                <span class="live-pill">
                  <span class="pulse-dot"></span>
                  Chegando em 3 min
                </span>
              </div>
              <h4 class="step-headline">Embarque na Estação E2 (Plataforma B - Sentido Centro)</h4>
              <p class="step-subtext">Veículo equipado com ar-condicionado • Próximo ônibus previsto para as 14:38.</p>

              <!-- Intermediate Stops Mini List -->
              <div class="intermediate-stops-box">
                <div class="stops-summary">
                  <span class="stops-count">6 paradas no corredor expresso (12 min)</span>
                  <span class="stops-corridor">Faixa exclusiva sem semáforo</span>
                </div>
                <div class="stops-tags-list">
                  <span class="stop-tag">E2 Arena</span>
                  <span class="stop-arrow">→</span>
                  <span class="stop-tag">E1 São Jorge</span>
                  <span class="stop-arrow">→</span>
                  <span class="stop-tag">Boulevard</span>
                  <span class="stop-arrow">→</span>
                  <span class="stop-tag">Praça da Saudade</span>
                  <span class="stop-arrow">→</span>
                  <span class="stop-tag highlight">Terminal 1 (T1)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3: Destination Arrival -->
          <div class="itinerary-step">
            <div class="timeline-gutter">
              <span class="timeline-dot dot-dest"></span>
            </div>
            <div class="timeline-content">
              <div class="step-meta">
                <span class="step-badge badge-dest">DESEMBARQUE</span>
                <span class="step-duration">Chegada às 14:46</span>
              </div>
              <h4 class="step-headline">Desembarque no Terminal 1 (T1) — Plataforma Central</h4>
              <p class="step-subtext">Acesso direto ao Centro Histórico ou baldeação gratuita para qualquer linha alimentadora.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Metrics & Live Navigation Bar -->
      <div class="planner-card-bottom-bar">
        <div class="metrics-cluster">
          <div class="metric-item">
            <span class="metric-val">18 min</span>
            <span class="metric-label">Tempo total estimado</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">240 m</span>
            <span class="metric-label">Percurso a pé</span>
          </div>
          <div class="metric-item">
            <span class="metric-val">R$ 0,00</span>
            <span class="metric-label">Integração temporal</span>
          </div>
        </div>

        <div class="planner-action-buttons">
          <a href="#instalar" class="planner-btn-primary">
            <span>Usar no Aplicativo</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
