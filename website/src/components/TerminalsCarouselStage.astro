---

<section class="terminals-carousel-section" id="terminais" aria-labelledby="terminais-heading">
  <div class="apple-container terminals-container">
    <!-- CABEÇALHO ELEGANTE DA SESSÃO -->
    <div class="terminals-header">
      <span class="terminals-eyebrow">SISTEMA INTEGRADO DE MANAUS</span>
      <h2 id="terminais-heading" class="terminals-headline">
        Terminais 1 ao 6 e Estações em Tempo Real
      </h2>
      <p class="terminals-subhead">
        Planeje conexões e baldeações com total segurança. Consulte plataformas, itinerários e previsões de chegada sem perder tempo.
      </p>
    </div>

    <!-- CONTROLES DO CARROSSEL (NAVEGAÇÃO RÁPIDA) -->
    <div class="terminals-nav-bar">
      <div class="terminal-tab-pills" role="tablist" aria-label="Lista de terminais e estações">
        {terminals.map((item, idx) => (
          <button 
            type="button" 
            class={`terminal-tab-btn ${idx === 0 ? 'active' : ''}`}
            data-target-index={idx}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span class="tab-badge">{item.badge}</span>
            <span class="tab-name">{item.id === 'estacoes' ? 'Estações' : `Terminal ${idx + 1}`}</span>
          </button>
        ))}
      </div>

      <div class="terminals-arrow-nav">
        <button type="button" class="terminals-arrow-btn prev-btn" id="terminalsPrevBtn" aria-label="Terminal anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="terminals-arrow-btn next-btn" id="terminalsNextBtn" aria-label="Próximo terminal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- CARROSSEL DE CARDS MODERNOS COM FOTOS REAIS -->
    <div class="terminals-carousel-stage" id="terminalsCarouselStage">
      {terminals.map((item, idx) => (
        <article 
          class={`terminal-card-slide ${idx === 0 ? 'active' : ''}`}
          data-slide-index={idx}
          role="tabpanel"
          aria-label={item.name}
        >
          <!-- FOTO REALISTA DO TERMINAL / ESTAÇÃO -->
          <div class="terminal-card-media">
            <img 
              src={item.image} 
              alt={item.name} 
              class="terminal-card-img" 
              width="600" 
              height="450" 
              loading={idx === 0 ? "eager" : "lazy"}
            />
            <div class="terminal-card-tag">
              <span class="pulse-dot"></span>
              <span>{item.tag}</span>
            </div>
            <div class="terminal-card-badge-pill">
              {item.badge}
            </div>
          </div>

          <!-- DETALHES OPERACIONAIS DO TERMINAL -->
          <div class="terminal-card-body">
            <div class="terminal-zone-meta">
              <span class="zone-label">{item.zone}</span>
            </div>

            <h3 class="terminal-card-title">{item.name}</h3>

            <p class="terminal-card-desc">{item.desc}</p>

            <div class="terminal-routes-list">
              <span class="routes-label">Linhas monitoradas:</span>
              <div class="routes-tags-row">
                {item.routes.map(r => (
                  <span class="route-tag-pill">{r}</span>
                ))}
              </div>
            </div>

            <div class="terminal-action-row">
              <a href="#instalar" class="btn-99-dark-pill" aria-label={`Monitorar ${item.name} no Manô`}>
                <span class="btn-99-label">Ver horários e linhas</span>
                <span class="btn-99-arrow-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function initTerminalsCarousel() {
    const stage = document.getElementById('terminalsCarouselStage');
    if (!stage) return;

    const slides = stage.querySelectorAll<HTMLElement>('.terminal-card-slide');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.terminal-tab-btn');
    const prevBtn = document.getElementById('terminalsPrevBtn');
    const nextBtn = document.getElementById('terminalsNextBtn');
    let currentIndex = 0;
    let autoInterval: number | null = null;

    function goToIndex(idx: number) {
      if (idx < 0) idx = slides.length - 1;
      if (idx >= slides.length) idx = 0;
      currentIndex = idx;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.add('active');
          slide.setAttribute('aria-hidden', 'false');
        } else {
          slide.classList.remove('active');
          slide.setAttribute('aria-hidden', 'true');
        }
      });

      tabs.forEach((tab, i) => {
        if (i === currentIndex) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        }
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = parseInt(tab.getAttribute('data-target-index') || '0', 10);
        goToIndex(target);
        resetAuto();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToIndex(currentIndex - 1);
        resetAuto();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToIndex(currentIndex + 1);
        resetAuto();
      });
    }

    function startAuto() {
      if (autoInterval) clearInterval(autoInterval);
      autoInterval = window.setInterval(() => {
        goToIndex(currentIndex + 1);
      }, 6000);
    }

    function resetAuto() {
      startAuto();
    }

    stage.addEventListener('mouseenter', () => {
      if (autoInterval) clearInterval(autoInterval);
    });

    stage.addEventListener('mouseleave', () => {
      startAuto();
    });

    startAuto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminalsCarousel);
  } else {
    initTerminalsCarousel();
  }
</script>
