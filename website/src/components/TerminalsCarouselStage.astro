  {
    id: 't1',
    badge: 'T1',
    name: 'Terminal 1 • Constantino Nery',
    zone: 'Centro Histórico & Sul',
    image: '/images/terminals/t1_constantino.webp',
    desc: 'O hub central de integração urbana de Manaus. Conecta as grandes linhas troncais da capital com o Centro e a Matriz.',
    routes: ['Linha 640', 'Linha 448', 'Linha 300', 'Linha 120'],
    tag: 'Centro • Hub Troncal'
  },
  {
    id: 't2',
    badge: 'T2',
    name: 'Terminal 2 • Cachoeirinha',
    zone: 'Zona Sul & Centro-Sul',
    image: '/images/terminals/t2_cachoeirinha.jpg',
    desc: 'Ponto estratégico de baldeação da Zona Sul com o Polo Industrial de Manaus, Educandos, Morro da Liberdade e Centro.',
    routes: ['Linha 016', 'Linha 450', 'Linha 612', 'Linha 619'],
    tag: 'Zona Sul • Conexão Distrito'
  },
  {
    id: 't3',
    badge: 'T3',
    name: 'Terminal 3 • Cidade Nova',
    zone: 'Zona Norte',
    image: '/images/terminals/t3_cidade_nova.jpg',
    desc: 'O coração do transporte público na Zona Norte. Interliga Cidade Nova, Nova Cidade, Canaranas e linhas alimentadoras.',
    routes: ['Linha 448', 'Linha 014', 'Linha 450', 'Linha 640'],
    tag: 'Zona Norte • Cidade Nova'
  },
  {
    id: 't4',
    badge: 'T4',
    name: 'Terminal 4 • Jorge Teixeira',
    zone: 'Zona Leste',
    image: '/images/terminals/t4_jorge_teixeira.jpg',
    desc: 'Grande terminal integrado na Av. Camapuã, conectando os bairros mais populosos da Zona Leste com o Norte e Centro.',
    routes: ['Linha 640', 'Linha 560', 'Linha 062', 'Linha 065'],
    tag: 'Zona Leste • Av. Camapuã'
  },
  {
    id: 't5',
    badge: 'T5',
    name: 'Terminal 5 • São José Operário',
    zone: 'Zona Leste & Distrito',
    image: '/images/terminals/t5_sao_jose.jpg',
    desc: 'Ponto neurálgico na Alameda Cosme Ferreira com intenso fluxo de integração dos trabalhadores com o Polo Industrial.',
    routes: ['Linha 650', 'Linha 652', 'Linha 678', 'Linha 619'],
    tag: 'Zona Leste • Polo Industrial'
  },
  {
    id: 't6',
    badge: 'T6',
    name: 'Terminal 6 • Lago Azul / Viver Melhor',
    zone: 'Extremo Norte',
    image: '/images/terminals/t6_lago_azul.jpg',
    desc: 'Terminal multimodal moderno no entroncamento da Av. Turismo com a AM-010, atendendo o Viver Melhor e o norte da capital.',
    routes: ['Linha 041', 'Linha 044', 'Linha 356', 'Linha 358'],
