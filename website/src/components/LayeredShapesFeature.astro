---
---

<section class="layered-shapes-section" id="integracao" aria-labelledby="integracao-heading">
  <div class="apple-container layered-shapes-container">
    <!-- FORMAS E SHAPES EM CAMADAS CONCÊNTRICAS (ESTILO ICÔNICO 99PAY) -->
    <div class="layered-shapes-visual">
      <div class="shapes-stack">
        <!-- Camada 1: Retângulo Arredondado Laranja Sólido (Sem Opacidade) -->
        <div class="shape-layer shape-layer-orange" aria-hidden="true"></div>

        <!-- Camada 2: Retângulo Arredondado Azul Sólido (Sem Opacidade) -->
        <div class="shape-layer shape-layer-blue" aria-hidden="true"></div>

        <!-- Camada 3: Retângulo Arredondado Frontal com Imagem Realista -->
        <div class="shape-layer shape-layer-front">
          <img 
            src="/images/card_terminal.webp" 
            alt="Passageiro no Terminal de Integração em Manaus" 
            class="shape-front-img" 
            width="460" 
            height="380" 
            loading="lazy" 
          />
          <div class="shape-front-badge">
            <span class="pulse-dot"></span>
            <span>T1 ao T5 &bull; Telemetria em Tempo Real</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CONTEÚDO TEXTUAL DIRETO COM BOTÃO PÍLULA ESTILO 99 -->
    <div class="layered-shapes-content">
      <span class="layered-eyebrow">INTEGRAÇÃO METROPOLITANA</span>
      <h2 id="integracao-heading" class="layered-headline">
        Terminais 1 ao 5 conectados em tempo real.
      </h2>
      <p class="layered-desc">
        Monitore partidas, chegadas e conexões dos <strong>5 principais terminais de Manaus</strong>. Planeje baldeações com segurança e <strong>embarque sem perder tempo na plataforma</strong>.
      </p>

      <div class="layered-action-row">
        <a href="#instalar" class="btn-99-pill" aria-label="Instalar o aplicativo Manô agora">
          <span class="btn-99-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
          <span class="btn-99-label">Instalar aplicativo</span>
        </a>
      </div>
    </div>
  </div>
</section>
