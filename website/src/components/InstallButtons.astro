---
import Icon from './Icon.astro';
import { installUrl } from '../config';
---
<div class="install-buttons">
  <a class="install-button primary" href={installUrl('ios')} data-install="ios"><Icon name="apple" size={24}/><span><small>Disponível para</small>Instalar no iPhone</span><span class="button-arrow">↗</span></a>
  <a class="install-button secondary" href={installUrl('android')} data-install="android"><Icon name="android" size={23}/><span><small>Disponível para</small>Instalar no Android</span><span class="button-arrow">↗</span></a>
</div>
