---
import Icon from './Icon.astro';
import { installUrl } from '../config';
---
<div class="install-buttons">
  <a class="install-button install-ios" href={installUrl('ios')} data-install="ios" aria-label="Instalar o aplicativo Manô no iPhone">
    <span class="button-icon-wrapper"><Icon name="apple" size={26}/></span>
    <span class="button-content">
      <span class="button-tag">Baixar Aplicativo</span>
      <strong class="button-title">Instalar no iPhone</strong>
    </span>
    <span class="button-arrow">↗</span>
  </a>
  <a class="install-button install-android" href={installUrl('android')} data-install="android" aria-label="Instalar o aplicativo Manô no Android">
    <span class="button-icon-wrapper"><Icon name="android" size={25}/></span>
    <span class="button-content">
      <span class="button-tag">Baixar Aplicativo</span>
      <strong class="button-title">Instalar no Android</strong>
    </span>
    <span class="button-arrow">↗</span>
  </a>
</div>
