---
---
<div class="hero-breakout-container" aria-hidden="true">
  <!-- Card 1: Live Line Arrival Card (Top Left) -->
  <div class="breakout-card card-arrival">
    <div class="card-pill-header">
      <span class="card-line-badge">640</span>
      <div class="card-arrival-meta">
        <strong>T1 Constantino Nery</strong>
        <span>Sentido Centro</span>
      </div>
    </div>
    <div class="card-arrival-footer">
      <div class="live-eta-indicator">
        <span class="live-pulse-dot"></span>
        <span>Próximo em <strong>3 min</strong></span>
      </div>
      <span class="speed-tag">38 km/h</span>
    </div>
  </div>

  <!-- Card 2: Terminal Platform Integration Card (Bottom Right) -->
  <div class="breakout-card card-terminal">
    <div class="card-terminal-badge">
      <span class="terminal-dot"></span>
      <span>Terminal 1 • Integração</span>
    </div>
    <div class="terminal-platform">
      <strong>Plataforma B</strong>
      <span class="platform-lines">640 • 300 • 448</span>
    </div>
  </div>
</div>
