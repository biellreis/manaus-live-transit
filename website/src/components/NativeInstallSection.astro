---
---

<section class="apple-install-section" id="instalar" aria-labelledby="instalar-heading">
  <div class="apple-container install-wide-container">
    <!-- Top Centered Lockup -->
    <div class="install-header-lockup">
      <div class="install-app-symbol" aria-hidden="true">
        <img src="/brand/icon.png" width="88" height="88" alt="Ícone do Manô" class="app-icon-squircle" />
      </div>

      <h2 id="instalar-heading" class="apple-section-headline">
        Sua cidade. Na sua mão.
      </h2>
      <p class="apple-section-subhead">
        Adicione o Manô e abra direto pelo ícone do aplicativo.
      </p>
    </div>

    <!-- 3 Step Cards Across Full Extension (Matching 99 card format) -->
    <div class="install-steps-grid">
      <div class="install-step-card">
        <div class="step-badge-circle">1</div>
        <div class="step-card-body">
          <h3 class="step-card-title">Abra no Navegador</h3>
          <p class="step-card-desc">Acesse pelo Safari no iOS ou pelo Chrome no Android <strong>sem intermediários</strong>.</p>
        </div>
      </div>

      <div class="install-step-card">
        <div class="step-badge-circle">2</div>
        <div class="step-card-body">
          <h3 class="step-card-title">Adicione à Tela de Início</h3>
          <p class="step-card-desc">Toque em Compartilhar e selecione <strong>Adicionar à Tela de Início</strong>.</p>
        </div>
      </div>

      <div class="install-step-card">
        <div class="step-badge-circle">3</div>
        <div class="step-card-body">
          <h3 class="step-card-title">Acesso Instantâneo</h3>
          <p class="step-card-desc">Abra pelo ícone oficial. <strong>Pesa menos de 3MB</strong> e atualiza sozinho.</p>
        </div>
      </div>
    </div>

    <!-- Action Buttons no shape da 99 com ícones perfeitamente centralizados -->
    <div class="install-actions-row install-actions-large">
      <button type="button" class="hero-btn-large hero-btn-apple hero-btn-99" id="appleInstallIphoneBtn" data-install="ios" aria-label="Instalar no iPhone via Safari">
        <span class="btn-icon-capsule btn-icon-capsule-apple">
          <svg class="btn-icon btn-icon-apple" viewBox="0 0 170 170" fill="currentColor" aria-hidden="true">
            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.59-7.71-11.66-14.01-6.19-9.5-11.03-20.2-14.52-32.08-3.48-11.89-5.23-23.08-5.23-33.59 0-14.22 3.58-26.04 10.74-35.46 7.16-9.42 16.14-14.28 26.94-14.58 4.89 0 10.42 1.34 16.59 4.02 6.17 2.68 10.15 4.07 11.94 4.07 1.48 0 5.69-1.48 12.63-4.44 6.94-2.96 12.69-4.26 17.26-3.9 12.87 1.05 23.01 5.92 30.43 14.62-11.16 6.77-16.63 16.27-16.42 28.51.22 9.68 3.86 17.77 10.92 24.28 7.06 6.51 15.42 10.05 25.07 10.63-2.12 6.34-4.82 12.98-8.1 19.92zm-35.14-106.82c0 6.66-2.4 12.96-7.2 17.9-4.8 4.94-10.74 8.04-17.82 9.31-.22-.85-.33-1.8-.33-2.85 0-6.45 2.59-12.8 7.77-18.06 5.18-5.26 11.23-8.29 18.15-9.09.22.85.33 1.8.33 2.79z"/>
          </svg>
        </span>
        <div class="btn-text-block">
          <span class="btn-subtext">Disponível para iOS</span>
          <span class="btn-maintext">Instalar no iPhone</span>
        </div>
      </button>

      <a href="/downloads/Mano.apk" download="Mano.apk" class="hero-btn-large hero-btn-android hero-btn-99 install-android" data-install="android" aria-label="Baixar aplicativo Manô no Android">
        <span class="btn-icon-capsule btn-icon-capsule-android">
          <svg class="btn-icon btn-icon-android" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.996-3.4572c.1126-.195.0456-.4445-.1494-.5571-.195-.1126-.4445-.0456-.5571.1494l-2.022 3.5022C15.602 8.358 13.856 8 12 8s-3.602.358-5.149 1.0587L4.829 5.5566c-.1126-.195-.3621-.262-.5571-.1494-.195.1126-.262.3621-.1494.5571l1.996 3.4572C2.688 11.1867.343 14.659.343 18.6586h23.314c0-3.9996-2.345-7.4719-5.7765-9.3372"/>
          </svg>
        </span>
        <div class="btn-text-block">
          <span class="btn-subtext">Disponível para Android</span>
          <span class="btn-maintext">Baixar Mano.apk</span>
        </div>
      </a>
    </div>
  </div>
</section>
