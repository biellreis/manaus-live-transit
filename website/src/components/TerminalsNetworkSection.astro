---
---

<section class="apple-terminals-section" id="terminais" aria-labelledby="terminais-heading">
  <div class="apple-container">
    <div class="apple-section-header">
      <h2 id="terminais-heading" class="apple-section-headline">
        Terminais
      </h2>
      <p class="apple-section-subhead">
        Integração total nos 5 terminais urbanos.
      </p>
    </div>

    <!-- Terminais de Integração T1 a T5 (Estilo Oficial TerminalsModal.tsx) -->
    <div class="native-terminals-container">
      <div class="terminals-group-title">
        <span class="amber-bar"></span>
        <span>TERMINAIS DE INTEGRAÇÃO (T1 A T5)</span>
      </div>

      <div class="terminals-native-grid">
        <!-- T1 -->
        <article class="native-terminal-card">
          <div class="terminal-card-main">
            <div class="terminal-badge-squircle amber">T1</div>
            <div class="terminal-text-block">
              <h3 class="terminal-card-title">Terminal 1 — Constantino Nery</h3>
              <p class="terminal-card-address">Centro • Conexão Corredores Norte e Sul</p>
              <div class="terminal-lines-row">
                <span class="lines-title">Linhas:</span>
                <div class="lines-chips-list">
                  <span class="line-badge blue">640</span>
                  <span class="line-badge blue">300</span>
                  <span class="line-badge orange">448</span>
                  <span class="line-badge orange">560</span>
                  <span class="line-badge blue">120</span>
                </div>
              </div>
            </div>
          </div>
          <div class="terminal-card-side">
            <span class="status-pill-ok">Operando</span>
            <span class="integration-pill">Integração R$ 0,00</span>
          </div>
        </article>

        <!-- T2 -->
        <article class="native-terminal-card">
          <div class="terminal-card-main">
            <div class="terminal-badge-squircle amber">T2</div>
            <div class="terminal-text-block">
              <h3 class="terminal-card-title">Terminal 2 — Cachoeirinha</h3>
              <p class="terminal-card-address">Zona Sul • Conexão Polo Industrial</p>
              <div class="terminal-lines-row">
                <span class="lines-title">Linhas:</span>
                <div class="lines-chips-list">
                  <span class="line-badge blue">650</span>
                  <span class="line-badge blue">651</span>
                  <span class="line-badge orange">542</span>
                  <span class="line-badge orange">418</span>
                  <span class="line-badge blue">715</span>
                </div>
              </div>
            </div>
          </div>
          <div class="terminal-card-side">
            <span class="status-pill-ok">Operando</span>
            <span class="integration-pill">Integração R$ 0,00</span>
          </div>
        </article>

        <!-- T3 -->
        <article class="native-terminal-card">
          <div class="terminal-card-main">
            <div class="terminal-badge-squircle amber">T3</div>
            <div class="terminal-text-block">
              <h3 class="terminal-card-title">Terminal 3 — Cidade Nova</h3>
              <p class="terminal-card-address">Zona Norte • Conexão Bairros e Max Teixeira</p>
              <div class="terminal-lines-row">
                <span class="lines-title">Linhas:</span>
                <div class="lines-chips-list">
                  <span class="line-badge blue">640</span>
                  <span class="line-badge blue">350</span>
                  <span class="line-badge orange">450</span>
                  <span class="line-badge blue">300</span>
                  <span class="line-badge blue">A030</span>
                </div>
              </div>
            </div>
          </div>
          <div class="terminal-card-side">
            <span class="status-pill-ok">Operando</span>
            <span class="integration-pill">Integração R$ 0,00</span>
          </div>
        </article>

        <!-- T4 -->
        <article class="native-terminal-card">
          <div class="terminal-card-main">
            <div class="terminal-badge-squircle amber">T4</div>
            <div class="terminal-text-block">
              <h3 class="terminal-card-title">Terminal 4 — Jorge Teixeira</h3>
              <p class="terminal-card-address">Zona Leste • Ponto de Partida Expresso 640</p>
              <div class="terminal-lines-row">
                <span class="lines-title">Linhas:</span>
                <div class="lines-chips-list">
                  <span class="line-badge blue">640</span>
                  <span class="line-badge orange">560</span>
                  <span class="line-badge blue">652</span>
                  <span class="line-badge orange">678</span>
                  <span class="line-badge blue">062</span>
                </div>
              </div>
            </div>
          </div>
          <div class="terminal-card-side">
            <span class="status-pill-ok">Operando</span>
            <span class="integration-pill">Integração R$ 0,00</span>
          </div>
        </article>

        <!-- T5 -->
        <article class="native-terminal-card">
          <div class="terminal-card-main">
            <div class="terminal-badge-squircle amber">T5</div>
            <div class="terminal-text-block">
              <h3 class="terminal-card-title">Terminal 5 — São José</h3>
              <p class="terminal-card-address">Zona Leste • Alameda Cosme Ferreira</p>
              <div class="terminal-lines-row">
                <span class="lines-title">Linhas:</span>
                <div class="lines-chips-list">
                  <span class="line-badge blue">652</span>
                  <span class="line-badge blue">600</span>
                  <span class="line-badge orange">671</span>
                  <span class="line-badge blue">008</span>
                  <span class="line-badge orange">014</span>
                </div>
              </div>
            </div>
          </div>
          <div class="terminal-card-side">
            <span class="status-pill-ok">Operando</span>
            <span class="integration-pill">Integração R$ 0,00</span>
          </div>
        </article>
      </div>

      <!-- Estações de Transferência dos Corredores (E1 a E4) -->
      <div class="terminals-group-title" style="margin-top: 36px;">
        <span class="blue-bar"></span>
        <span>ESTAÇÕES DE TRANSFERÊNCIA DOS CORREDORES (E1 A E4)</span>
      </div>

      <div class="stations-native-grid">
        <div class="native-station-card">
          <div class="terminal-badge-squircle blue">E1</div>
          <div class="station-card-text">
            <strong>Estação E1 — São Jorge</strong>
            <span>Av. Constantino Nery • Plataformas A e B</span>
          </div>
        </div>

        <div class="native-station-card">
          <div class="terminal-badge-squircle blue">E2</div>
          <div class="station-card-text">
            <strong>Estação E2 — Arena da Amazônia</strong>
            <span>Av. Constantino Nery • Acesso Pedro Teixeira</span>
          </div>
        </div>

        <div class="native-station-card">
          <div class="terminal-badge-squircle blue">E3</div>
          <div class="station-card-text">
            <strong>Estação E3 — Santos Dumont</strong>
            <span>Av. Constantino Nery • Plataformas A e B</span>
          </div>
        </div>

        <div class="native-station-card">
          <div class="terminal-badge-squircle blue">E4</div>
          <div class="station-card-text">
            <strong>Estação E4 — Flores</strong>
            <span>Av. Torquato Tapajós • Parque das Laranjeiras</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
