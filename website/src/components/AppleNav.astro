---
import { installUrl } from '../config';
---

<header class="apple-localnav" id="appleLocalNav">
  <div class="apple-localnav-wrapper">
    <!-- Brand / Title -->
    <div class="apple-localnav-title">
      <a href="#" class="apple-brand-link" aria-label="Manô Início">
        <img src="/brand/icon.png" width="22" height="22" alt="" class="apple-brand-icon"/>
        <span class="apple-brand-text">Manô</span>
      </a>
    </div>

    <!-- Navigation links & CTA -->
    <div class="apple-localnav-actions">
      <nav class="apple-localnav-menu" aria-label="Navegação da página">
        <a href="#destaques" class="apple-localnav-link">Destaques</a>
        <a href="#closer-look" class="apple-localnav-link">Visão 3D</a>
        <a href="#trajetos" class="apple-localnav-link">Trajetos</a>
        <a href="#veiculos" class="apple-localnav-link">No Mapa</a>
        <a href="#alertas" class="apple-localnav-link">Alertas</a>
      </nav>

      <div class="apple-localnav-cta-group">
        <a href={installUrl('ios')} class="apple-pill-btn apple-pill-blue" data-install="ios" aria-label="Instalar aplicativo Manô">
          Instalar
        </a>
      </div>
    </div>
  </div>
</header>
