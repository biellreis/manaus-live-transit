---
import '../styles/global.css';

// Componentes da Arquitetura Flagship (Estrutura 99app + Apple)
import AppleNav from '../components/AppleNav.astro';
import AppleHeroStage from '../components/AppleHeroStage.astro';
import RoutineBenefitsSection from '../components/RoutineBenefitsSection.astro';
import AppShowcaseStage from '../components/AppShowcaseStage.astro';
import TerminalsCarouselStage from '../components/TerminalsCarouselStage.astro';
import NativeInstallSection from '../components/NativeInstallSection.astro';
import InstallModal from '../components/InstallModal.astro';

// SEO JSON-LD Estruturado para Google Rich Snippets
const schemaApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Manô — O Transporte de Manaus em Tempo Real",
  "operatingSystem": "iOS, Android, Web",
  "applicationCategory": "TravelApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL"
  },
  "description": "Monitore linhas de ônibus, horários e paradas de Manaus em tempo real sem atrasos. Telemetria GPS com latência abaixo de 850ms e integração dos 5 terminais urbanos.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1420"
  }
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#000000"/>
  <meta name="description" content="Chega de esperar no escuro na parada. Monitore linhas de ônibus, itinerários e paradas de Manaus em tempo real. Telemetria GPS com latência mínima, 5 terminais integrados e 100% gratuito."/>
  <meta name="keywords" content="onibus manaus, linhas de onibus manaus, horario de onibus manaus, rastrear onibus manaus em tempo real, linha 640 manaus, terminal de integracao manaus, transporte publico manaus"/>
  <title>Manô — O Transporte de Manaus em Tempo Real</title>
  <meta name="apple-mobile-web-app-title" content="Manô"/>
  <meta name="application-name" content="Manô"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png"/>
  <meta property="og:title" content="Manô — Chega de esperar no escuro na parada"/>
  <meta property="og:description" content="Monitore linhas de ônibus, itinerários e paradas de Manaus em tempo real com telemetria GPS. 100% gratuito e sem anúncios."/>
  <meta property="og:type" content="website"/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaApp)} />

  <!-- Bloqueio estrito de restauração de scroll no mobile antes do primeiro render -->
  <script is:inline>
    if (typeof history !== 'undefined' && 'scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    if (window.location.hash) {
      try {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      } catch (_) {}
    }
    window.scrollTo(0, 0);
    if (document.documentElement) document.documentElement.scrollTop = 0;
    if (document.body) document.body.scrollTop = 0;

    // Garante que qualquer tentativa de rolagem automática pelo navegador nos primeiros 500ms seja neutralizada
    var __scrollLockEnd = Date.now() + 500;
    function __lockEarlyScroll() {
      if (Date.now() < __scrollLockEnd) {
        if (window.scrollY !== 0) {
          window.scrollTo(0, 0);
        }
      } else {
        window.removeEventListener('scroll', __lockEarlyScroll);
      }
    }
    window.addEventListener('scroll', __lockEarlyScroll, { passive: true });
  </script>
</head>
<body>

<!-- 1. BARRA DE NAVEGAÇÃO LOCAL FIXA -->
<AppleNav/>

<main id="conteudo">
  <!-- SESSÃO 1: HERO SPLIT DA 99 EM EXTENSÃO TOTAL COM MAPA ANIMADO NO LADO ESQUERDO -->
  <AppleHeroStage/>

  <!-- SESSÃO 2: GRADE DE 4 VANTAGENS NA ROTINA COM FOTOS NO TOPO (ESTILO 99APP) -->
  <RoutineBenefitsSection/>

  <!-- SESSÃO 3: O SHOWCASE CENTRAL (CARROSSEL COM FOTO REALISTA + 4 MÉTRICAS ATRAENTES) -->
  <AppShowcaseStage/>

  <!-- SESSÃO 4: NOVO CARROSSEL MODERNO DE TERMINAIS 1 AO 6 E ESTAÇÕES DE MANAUS -->
  <TerminalsCarouselStage/>

  <!-- SESSÃO 5: GUIA VISUAL DE INSTALAÇÃO DIRETA NO IPHONE E ANDROID (MANTIDA) -->
  <NativeInstallSection/>
</main>

<!-- RODAPÉ MINIMALISTA: COPYRIGHT ÚNICO -->
<footer class="apple-footer">
  <div class="apple-footer-wrap apple-footer-minimal">
    <span class="copyright">Copyright © 2026 Manô Inc. Todos os direitos reservados.</span>
  </div>
</footer>

<InstallModal/>
<script src="../scripts/main.ts"></script>
</body>
</html>
