---
import '../styles/global.css';

// Componentes no padrão Apple Flagship
import AppleNav from '../components/AppleNav.astro';
import AppleHeroStage from '../components/AppleHeroStage.astro';
import HighlightsRibbon from '../components/HighlightsRibbon.astro';
import ProductViewer3D from '../components/ProductViewer3D.astro';
import PredictiveEngineSection from '../components/PredictiveEngineSection.astro';
import TripPlannerSection from '../components/TripPlannerSection.astro';
import TerminalsNetworkSection from '../components/TerminalsNetworkSection.astro';
import CityAlertsSection from '../components/CityAlertsSection.astro';
import NativeInstallSection from '../components/NativeInstallSection.astro';
import InstallModal from '../components/InstallModal.astro';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#000000"/>
  <meta name="description" content="Sua cidade, seu caminho. Conheça o Manô: telemetria em tempo real, motor preditivo de chegada e itinerários completos de Manaus. 100% PWA nativo."/>
  <title>Manô — O Transporte de Manaus em Tempo Real</title>
  <meta name="apple-mobile-web-app-title" content="Manô"/>
  <meta name="application-name" content="Manô"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png"/>
  <meta property="og:title" content="Manô — Mobilidade Urbana em Manaus"/>
  <meta property="og:description" content="Telemetria em tempo real, motor preditivo de chegada, trajetos de linhas expressas e integração dos 5 terminais urbanos de Manaus."/>
  <meta property="og:type" content="website"/>
</head>
<body>

<!-- 1. BARRA DE NAVEGAÇÃO LOCAL FIXA (APPLE LOCAL NAV) -->
<AppleNav/>

<main id="conteudo">
  <!-- 2. SESSÃO HERO CINEMATOGRÁFICA COM VÍDEO 3D DE ESTÚDIO FRONTAL -->
  <AppleHeroStage/>

  <!-- 3. CARROSSEL DE DESTAQUES APPLE ("GET THE HIGHLIGHTS.") -->
  <HighlightsRibbon/>

  <!-- 4. VISÃO DETALHADA DO PRODUTO FRONTAL EM ESTÚDIO ("TAKE A CLOSER LOOK. ZERO TRASEIRA.") -->
  <ProductViewer3D/>

  <!-- 5. ARQUITETURA: MOTOR PREDITIVO EM TEMPO REAL (BENTO GRID APPLE SILICON) -->
  <PredictiveEngineSection/>

  <!-- 6. PLANEJADOR INTELIGENTE DE VIAGENS PONTO A PONTO -->
  <TripPlannerSection/>

  <!-- 7. REDE DE INTEGRAÇÃO URBANA: TERMINAIS T1 A T5 E ESTAÇÕES DE TRANSFERÊNCIA -->
  <TerminalsNetworkSection/>

  <!-- 8. CENTRAL DE ALERTAS DA CIDADE E DEFESA CIVIL (ZERO NEON) -->
  <CityAlertsSection/>

  <!-- 9. GUIA VISUAL DE INSTALAÇÃO PWA DIRETA NO IPHONE E ANDROID -->
  <NativeInstallSection/>
</main>

<!-- 10. APPLE CANON MINIMAL FOOTER -->
<footer class="apple-footer">
  <div class="apple-footer-wrap apple-footer-minimal">
    <span class="copyright">Copyright © 2026 Manô Inc. Todos os direitos reservados.</span>
  </div>
</footer>

<InstallModal/>
<script src="../scripts/main.ts"></script>
</body>
</html>
