---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import InstallButtons from '../components/InstallButtons.astro';
import HeroTransitMap from '../components/HeroTransitMap.astro';
import ShowcaseFan from '../components/ShowcaseFan.astro';
import LiveTransitMap from '../components/LiveTransitMap.astro';
import InstallModal from '../components/InstallModal.astro';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#09090b"/><meta name="description" content="Sua cidade, seu caminho. Conheça o Manô: planeje viagens, encontre linhas e acompanhe os ônibus de Manaus. Instale no iPhone ou Android."/>
  <title>Manô — Manaus na sua mão.</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png"/>
  <meta property="og:title" content="Manô — Manaus na sua mão."/><meta property="og:description" content="Seu próximo caminho começa aqui. Linhas, trajetos e conexões em um só aplicativo."/><meta property="og:type" content="website"/>
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header class="header"><a href="#" class="brand" aria-label="Manô, início"><img src="/brand/icon.png" width="38" height="38" alt="" class="brand-logo-img"/><img src="/brand/original-name-white.png" width="92" height="23" alt="Manô" class="brand-name-img"/></a><nav aria-label="Principal"><a href="#recursos">O aplicativo</a><a href="#trajetos">Trajetos</a><a href="#conexoes">Conexões</a></nav><a class="nav-install" href="#instalar">Instalar Manô <span>↗</span></a></header>
<main id="conteudo">
  <section class="hero hero-fullscreen" aria-labelledby="hero-title">
    <HeroTransitMap/>

    <div class="hero-center-content">
      <div class="hero-apple-glass">
        <h1 id="hero-title" class="hero-mega-title">
          Manô, <span class="blue">bora?</span>
        </h1>

        <p class="hero-mega-description">
          O transporte público de Manaus em tempo real no seu celular.
        </p>

        <div class="hero-actions-container">
          <InstallButtons/>
        </div>
      </div>
    </div>

    <div class="hero-foot">
      <a href="#recursos" class="hero-scroll-cue">Explore o Manô <span>↓</span></a>
    </div>
  </section>

  <div class="feature-nav">
    <div class="wrap">
      <a href="#planejar"><Icon name="route"/>Planejar</a>
      <a href="#linhas"><Icon name="search"/>Linhas</a>
      <a href="#trajetos"><Icon name="bus"/>Trajetos</a>
      <a href="#veiculos"><Icon name="map"/>No Mapa</a>
      <a href="#conexoes"><Icon name="pin"/>Conexões</a>
      <a href="#alertas"><Icon name="bell"/>Alertas</a>
    </div>
  </div>

  <section class="intro wrap" id="recursos">
    <div class="intro-header">
      <p class="eyebrow">A CIDADE NÃO PARA. VOCÊ TAMBÉM NÃO.</p>
      <h2>Um aplicativo.<br/><span class="muted">Todos os seus caminhos.</span></h2>
      <p class="intro-lead">Do primeiro passo até a sua parada.<br/>O Manô conecta você ao transporte de Manaus.</p>
    </div>
    <ShowcaseFan/>
  </section>

  <section class="chapter wrap planner" id="planejar">
    <div class="chapter-copy">
      <p class="eyebrow"><span class="chapter-number">01</span> PLANEJE SUA VIAGEM</p>
      <h2>Para onde<br/>vamos <span class="blue">hoje?</span></h2>
      <p>Escolha de onde sair e aonde chegar.<br/>Encontre as melhores linhas e os passos do seu percurso.</p>
      <div class="journey-steps" aria-label="Etapas do planejamento">
        <button class="step active" data-planner="planner" aria-pressed="true">
          <span>1</span>
          <div>Escolha seu destino</div>
          <span>↗</span>
        </button>
        <button class="step" data-planner="journey" aria-pressed="false">
          <span>2</span>
          <div>Veja como chegar</div>
          <span>↗</span>
        </button>
      </div>
    </div>
    <div class="chapter-art planner-art">
      <div class="route-ring"></div>
      <Phone screen="planner" id="planner-screen" class="feature-phone"/>
    </div>
  </section>

  <section class="lines-section" id="linhas">
    <div class="wrap lines-grid">
      <div>
        <p class="eyebrow"><span class="chapter-number">02</span> ENCONTRE SUA LINHA</p>
        <h2>A sua linha.<br/><span class="muted">Sem complicar.</span></h2>
        <p>Busque pelo número, explore as opções<br/>e encontre o caminho que faz sentido para você.</p>
      </div>
      <div class="line-stack" aria-label="Exemplos de linhas disponíveis no aplicativo">
        <div class="line-row"><span class="line-code">640</span><div>T4 / T3 / E4 / E2 / E1 / T1</div><span>↗</span></div>
        <div class="line-row"><span class="line-code">300</span><div>Expresso Norte (T4 / T3)</div><span>↗</span></div>
        <div class="line-row"><span class="line-code">448</span><div>Cidade de Deus / T3 / T4</div><span>↗</span></div>
      </div>
    </div>
  </section>

  <section class="route-section wrap" id="trajetos">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><span class="chapter-number">03</span> CADA SENTIDO, UM CAMINHO</p>
        <h2>Na ida. Na volta.<br/><span class="blue">Com você.</span></h2>
      </div>
      <div>
        <p>Visualize o percurso e suas paradas.<br/>Escolha o sentido e acompanhe no mapa.</p>
        <div class="segmented" role="group" aria-label="Sentido do trajeto">
          <button data-route="ida" class="active" aria-pressed="true">↗ Ida</button>
          <button data-route="volta" aria-pressed="false">↙ Volta</button>
        </div>
      </div>
    </div>
    <div class="route-stage">
      <svg class="route-decoration" viewBox="0 0 1100 560" fill="none" aria-hidden="true">
        <path d="M-50 400H190Q250 400 250 340V230Q250 180 310 180H810Q870 180 870 120V90Q870 40 930 40H1170" stroke="currentColor" stroke-width="2"/>
        <path d="M-50 460H250Q320 460 320 400V290Q320 240 380 240H870Q930 240 930 180V150Q930 100 990 100H1170" stroke="currentColor" stroke-width="1" opacity=".2"/>
        <circle cx="250" cy="300" r="8" fill="currentColor"/>
        <circle cx="870" cy="100" r="8" fill="currentColor"/>
      </svg>
      <Phone screen="ida" id="route-screen" class="route-phone"/>
      <div class="route-note">
        <span class="line-code">640</span>
        <h3 id="route-title">Seu trajeto de ida.</h3>
        <p id="route-description">Veja o percurso e as paradas<br/>antes mesmo de embarcar.</p>
      </div>
    </div>
  </section>

  <section class="live-section wrap" id="veiculos">
    <div class="live-copy">
      <p class="eyebrow"><span class="chapter-number">04</span> ÔNIBUS NO MAPA</p>
      <h2>Seu ônibus.<br/>Mais <span class="blue">perto.</span></h2>
      <p>Acompanhe os veículos disponíveis na sua linha.<br/>Mais informação para decidir quando sair.</p>
    </div>
    <div class="map-window">
      <LiveTransitMap/>
    </div>
  </section>

  <section class="connections-section" id="conexoes">
    <div class="wrap">
      <div class="center-heading">
        <p class="eyebrow"><span class="chapter-number">05</span> CONEXÕES QUE APROXIMAM</p>
        <h2>Da sua parada.<br/><span class="muted">Para toda a cidade.</span></h2>
        <p>Encontre paradas próximas, terminais e estações de integração.</p>
      </div>
      <div class="connection-gallery">
        <Phone screen="nearby" class="connection-side left"/>
        <Phone screen="terminals" id="connection-screen" class="connection-main"/>
        <Phone screen="stations" class="connection-side right"/>
      </div>
      <div class="segmented connections-tabs" role="group" aria-label="Explore as conexões">
        <button class="active" data-connection="terminals" aria-pressed="true">Terminais</button>
        <button data-connection="stations" aria-pressed="false">Estações</button>
        <button data-connection="nearby" aria-pressed="false">Perto de você</button>
      </div>
    </div>
  </section>

  <section class="chapter alerts-section wrap" id="alertas">
    <div class="chapter-art alert-art">
      <div class="orange-disc"></div>
      <Phone screen="alerts" class="alert-phone"/>
      <span class="alert-badge"><Icon name="bell" size={26}/></span>
    </div>
    <div class="chapter-copy">
      <p class="eyebrow orange"><span class="chapter-number">06</span> NO RITMO DA CIDADE</p>
      <h2>Saiba antes.<br/><span class="orange">Vá melhor.</span></h2>
      <p>Informações de trânsito em um só lugar.<br/>Confira os alertas e siga mais informado.</p>
    </div>
  </section>

  <section class="install-section wrap" id="instalar">
    <div class="install-symbol">
      <img src="/brand/icon.png" width="88" height="88" alt="Ícone do Manô" class="install-icon-main"/>
    </div>
    <p class="eyebrow">SEU PRÓXIMO CAMINHO COMEÇA AQUI.</p>
    <h2>Leve o Manô<br/><span class="blue">com você.</span></h2>
    <p>Seu aplicativo de mobilidade em Manaus.<br/>No iPhone. No Android. Na sua rotina.</p>
    <InstallButtons/>

    <div class="faq">
      <details>
        <summary>Preciso baixar de uma loja de aplicativos?<span>+</span></summary>
        <p>Não. O Manô é adicionado direto à sua tela inicial sem precisar de lojas. No iPhone, basta seguir os 4 toques pelo Safari. No Android, toque em Instalar e confirme no navegador.</p>
      </details>
      <details>
        <summary>Funciona sem internet?<span>+</span></summary>
        <p>Para consultar informações atualizadas, planejar viagens e acompanhar os ônibus, mantenha uma conexão com a internet.</p>
      </details>
      <details>
        <summary>O que aparece no mapa é ao vivo?<span>+</span></summary>
        <p>No aplicativo, os veículos são atualizados conforme os dados de telemetria e GPS da operação de transporte de Manaus.</p>
      </details>
    </div>
  </section>
</main>
<footer class="footer-minimal wrap">
  <div class="footer-center">
    <div class="footer-brand">
      <img src="/brand/icon.png" width="34" height="34" alt="" class="brand-logo-img"/>
      <img src="/brand/original-name-white.png" width="84" height="21" alt="Manô" class="brand-name-img"/>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Manô</span>
    </div>
  </div>
</footer>
<InstallModal/>
<script src="../scripts/main.ts"></script>
</body></html>
